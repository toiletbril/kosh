# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=shit
pkgver=0.1.0
pkgrel=0
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
url="https://github.com/toiletbril/shit"
arch="x86_64 aarch64"
license="BSD-3-Clause"
makedepends="build-base clang llvm lld musl-dev linux-headers git make"

# Pinned to the exact commit the "src/toiletline" submodule points to for
# this release (see .gitmodules / `git submodule status`). GitHub's tarball
# for a tag does not include submodule contents, so it's fetched separately
# and dropped into place in prepare().
_toiletline_commit="024fa036a7306ed07751fe90fbd583c9a6c2086c"

source="
	$pkgname-$pkgver.tar.gz::https://github.com/toiletbril/shit/archive/refs/tags/$pkgver.tar.gz
	toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz
	"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	rm -rf "$builddir/src/toiletline"
	cp -r "$srcdir/toiletline-$_toiletline_commit" "$builddir/src/toiletline"
}

build() {
	make MODE=rel
}

package() {
	install -Dm755 shit "$pkgdir/usr/bin/shit"
	install -Dm644 docs/shit.1 "$pkgdir/usr/share/man/man1/shit.1"
	install -Dm644 docs/shit.5 "$pkgdir/usr/share/man/man5/shit.5"
	install -Dm644 completions/shit.bash "$pkgdir/usr/share/bash-completion/completions/shit"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

sha512sums="
7b9555f471b9ea8c990983154ea8350cc29889cb8471018d12ff71983cb637daba0666b5908c456a38ab173a0b074322789f6bb0c2223653a0ffc019b4373980  shit-0.1.0.tar.gz
c53820b0ed058776c213ecf4c7bdf11fb095d9b24c261bd503f4a655b7417ddef943cbc732c6b6aa4883fa89cd677b90b8a7ac29cef6a5d2ae9449606cf81763  toiletline-024fa036a7306ed07751fe90fbd583c9a6c2086c.tar.gz
"
