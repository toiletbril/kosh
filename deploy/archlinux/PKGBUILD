# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=shit
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
arch=('x86_64' 'aarch64')
url="https://github.com/toiletbril/shit"
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('zig' 'git')
optdepends=('bash: bash mood/mimicry support'
            'dash: sh/dash mood/mimicry support')
provides=('shit')
conflicts=('shit')
source=("$pkgname::git+$url.git#tag=$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  git submodule update --init --recursive
}

build() {
  cd "$pkgname"
  zig build --release=fast
}

package() {
  cd "$pkgname"
  install -Dm755 zig-out/bin/shit "$pkgdir/usr/bin/shit"
  install -Dm644 docs/shit.1 "$pkgdir/usr/share/man/man1/shit.1"
  install -Dm644 docs/shit.5 "$pkgdir/usr/share/man/man5/shit.5"
  install -Dm644 completions/shit.bash "$pkgdir/usr/share/bash-completion/completions/shit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
