# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=shit-shell
_upstream_name=shit
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
arch=('x86_64' 'aarch64')
url="https://github.com/toiletbril/shit"
license=('BSD-3-Clause AND MIT')
depends=('glibc')
makedepends=('clang' 'git')
conflicts=('shit')
install=shit-shell.install
_release_commit="c2731c40d2cb3770f5fd3f6f7bfdc68d55f05483"
_release_epoch=1785870591
_toiletline_commit="024fa036a7306ed07751fe90fbd583c9a6c2086c"
export SOURCE_DATE_EPOCH="$_release_epoch"
source=(
  "$_upstream_name-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
  "toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz"
)
sha512sums=(
  '7b9555f471b9ea8c990983154ea8350cc29889cb8471018d12ff71983cb637daba0666b5908c456a38ab173a0b074322789f6bb0c2223653a0ffc019b4373980'
  'c53820b0ed058776c213ecf4c7bdf11fb095d9b24c261bd503f4a655b7417ddef943cbc732c6b6aa4883fa89cd677b90b8a7ac29cef6a5d2ae9449606cf81763'
)

prepare() {
  rm -rf "$srcdir/$_upstream_name-$pkgver/src/toiletline"
  cp -r "$srcdir/toiletline-$_toiletline_commit" \
    "$srcdir/$_upstream_name-$pkgver/src/toiletline"
}

build() {
  cd "$srcdir/$_upstream_name-$pkgver"
  make MODE=rel ENVCXXFLAGS="$CXXFLAGS $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Arch Linux"
}

package() {
  cd "$srcdir/$_upstream_name-$pkgver"
  install -Dm755 shit "$pkgdir/usr/bin/shit"
  install -Dm644 docs/shit.1 "$pkgdir/usr/share/man/man1/shit.1"
  install -Dm644 docs/shit.5 "$pkgdir/usr/share/man/man5/shit.5"
  install -Dm644 completions/shit.bash "$pkgdir/usr/share/bash-completion/completions/shit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/toiletline/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.toiletline"
}
