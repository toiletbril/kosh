# Contributor: Alexey Andreyev <dev@aa13q.ru>
pkgname=kosh-shell
_upstream_name=kosh
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, portable, Bash-compatible interactive shell, interpreter and diagnostic tool"
arch=('x86_64' 'aarch64')
url="https://github.com/toiletbril/kosh"
license=('BSD-3-Clause AND MIT')
depends=('glibc')
makedepends=('clang' 'git')
conflicts=('kosh')
install=kosh-shell.install
_release_commit="c2731c40d2cb3770f5fd3f6f7bfdc68d55f05483"
_release_epoch=1785870591
_source_directory="toiletbril-kosh-c2731c4"
_toiletline_commit="024fa036a7306ed07751fe90fbd583c9a6c2086c"
export SOURCE_DATE_EPOCH="$_release_epoch"
source=(
  "$_upstream_name-$pkgver.tar.gz::https://api.github.com/repos/toiletbril/kosh/tarball/$pkgver"
  "toiletline-$_toiletline_commit.tar.gz::https://github.com/toiletbril/toiletline/archive/$_toiletline_commit.tar.gz"
)
sha512sums=(
  '387f835c2fda2e2fe03f89779197e8c5658ca4c0c573a8641d2771371097dfcc6d8df3f66be517fd1628928fcb52a0509770cc80e9861777ddd10659832fca27'
  'c53820b0ed058776c213ecf4c7bdf11fb095d9b24c261bd503f4a655b7417ddef943cbc732c6b6aa4883fa89cd677b90b8a7ac29cef6a5d2ae9449606cf81763'
)

prepare() {
  rm -rf "$srcdir/$_source_directory/src/toiletline"
  cp -r "$srcdir/toiletline-$_toiletline_commit" \
    "$srcdir/$_source_directory/src/toiletline"
}

build() {
  cd "$srcdir/$_source_directory"
  make MODE=rel ENVCXXFLAGS="$CXXFLAGS $LDFLAGS" \
    COMMIT_HASH="$_release_commit" OS_INFO="Arch Linux"
}

package() {
  cd "$srcdir/$_source_directory"
  install -Dm755 kosh "$pkgdir/usr/bin/kosh"
  install -Dm644 docs/kosh.1 "$pkgdir/usr/share/man/man1/kosh.1"
  install -Dm644 docs/kosh.5 "$pkgdir/usr/share/man/man5/kosh.5"
  install -Dm644 completions/kosh.bash "$pkgdir/usr/share/bash-completion/completions/kosh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/toiletline/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.toiletline"
}
