[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "a" "$(echo b)" "c"]
  [CompoundListCondition, None]
    [Assign v=$(echo hello)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "got=$v"]
  [CompoundListCondition, None]
    [Assign result=$(echo hello  # a ) comment
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$result"]
  [CompoundListCondition, None]
    [Assign mid=$(echo foo#bar)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$mid"]
  [CompoundListCondition, None]
    [Assign quoted=$(echo "a # ) b")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$quoted"]
  [CompoundListCondition, None]
    [Assign nested=$(echo $(echo inner # ) cmt
))]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$nested"]
  [CompoundListCondition, None]
    [Assign x=$( cat <<< "payload" )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "x=$x"]
  [CompoundListCondition, None]
    [Assign empty=]
  [CompoundListCondition, None]
    [Assign y=$( cat <<<"$empty" )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "y=$y"]
  [CompoundListCondition, None]
    [Assign z=$( echo "$( echo nested )" -- "$x" )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "z=$z"]
  [CompoundListCondition, None]
    [Assign w=$( echo "$( printf '%s\n' "'")")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "w=$w"]
  [CompoundListCondition, None]
    [Assign line=part value tail]
  [CompoundListCondition, None]
    [Assign tar=$( printf '%s\n' "$line" | sed -e 's/^.* \([^ ]*x\) .*$/\1/' <<<"$line" )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tar=$tar"]
  [CompoundListCondition, None]
    [FunctionDefinition "f"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$(echo hi)"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$(echo $(echo deep))"]
  [CompoundListCondition, None]
    [ForLoop "w"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "i=$w"]
  [CompoundListCondition, None]
    [Assign x=$(false)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after_false=$?"]
  [CompoundListCondition, None]
    [Assign y=$(true)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after_true=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "$(false)"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bare_csub=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "${ false;  }"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bare_funsub=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "true"]
  [CompoundListCondition, None]
    [SimpleCommand "$(false)"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "vanished_word=$?"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "last_assign=$?"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "last_assign2=$?"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "plain_assign=$?"]
