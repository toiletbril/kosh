[CompoundList]
  [CompoundListCondition, None]
    [Assign start=$PWD]
  [CompoundListCondition, None]
    [Assign directory=$TEST_TEMP_DIRECTORY/glob-dot-slash]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "rm" "-rf" "$directory"]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "mkdir" "-p" "$directory"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$directory"]
  [CompoundListCondition, &&]
    [SimpleCommand ":"]
  [CompoundListCondition, &&]
    [SimpleCommand ":"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "./*.sh"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "*.sh"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$start"]
  [CompoundListCondition, None]
    [SimpleCommand "shitbox" "rm" "-rf" "$directory"]
[Word
  Unquoted "start="
  Variable "PWD"
]
[Word
  Unquoted "directory="
  Variable "TEST_TEMP_DIRECTORY"
  Unquoted "/glob-dot-slash"
]
