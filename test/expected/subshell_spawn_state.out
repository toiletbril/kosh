process=a'b:one:nine:map value:function:first second:child-name:on:dirsalias
compound=a'b:one:nine:map value:function:first second:child-name:on:dirs
status-process=1
status-compound=1
runtime-marks-process=upfa
runtime-marks-compound=upfa
implicit-shopt-process=on
implicit-shopt-compound=on
aliases-process=printf carried:printf written:present
aliases-compound=printf carried:printf written:present
ordinary-aliases-process=value:retained
ordinary-aliases-compound=value:retained
dirstack-process=/usr /bin /:/bin
dirstack-compound=/usr /bin /:/bin
ordinary-dirstack-process=ordinary array:/bin
ordinary-dirstack-compound=ordinary array:/bin
mood=sh
restricted-process=yes
restricted-compound=yes
identity-process=pid:level:depth:bashpid
identity-compound=pid:level:depth:bashpid
local-process=parent:child
local-compound=parent:child
stack-process=yes
stack-compound=yes
external-state=pid:status:depth
pipeline-state=before
pipeline-output=1
pipeline-status=0
internal-startup=skipped
