[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "abc\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "abd\n"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\nc\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "b\nc\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cksum" "first" "empty"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cksum-status=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cmp" "first" "first"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cmp-equal=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cmp" "-s" "first" "second"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cmp-different=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cmp" "-l" "first" "second"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cmp-list=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "comm" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "comm" "-12" "left" "right"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "1\n\t2\n\t\t3\n4\n\t5\n\t\t6\n7\n\t8\n\t\t9\n"]
      [SimpleCommand "koshkit" "comm" "-" "-"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a b\na c\nb d\nc d\n"]
      [SimpleCommand "koshkit" "tsort"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tsort-status=$?"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a b\n"]
      [SimpleCommand "koshkit" "tsort" "-"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tsort-dash=$?"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a b c\n"]
      [SimpleCommand "koshkit" "tsort" "-"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tsort-odd=$?"]
