[CompoundList]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "--color" "invalid" "evil"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "invalid-color=$?"]
  [CompoundListCondition, None]
    [Assign test_passwd=$TEST_TEMP_DIRECTORY/evil-passwd]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "first:x\nsecond:x\n"]
  [CompoundListCondition, None]
    [SimpleCommand "export" "KOSH_TEST_PASSWD=$test_passwd"]
  [CompoundListCondition, None]
    [Assign evil_all=$(koshkit --color never evil -as)]
  [CompoundListCondition, None]
    [CaseClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "all-users=present"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "all-users=absent"]
  [CompoundListCondition, None]
    [Assign evil_users=$(koshkit --color never evil -su)]
  [CompoundListCondition, None]
    [CaseClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "users=present"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "users=missing"]
[Word
  Unquoted "koshkit"
