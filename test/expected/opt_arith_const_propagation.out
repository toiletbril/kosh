[CompoundList]
  [CompoundListCondition, None]
    [Assign x=10]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x*2+1))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x+x))"]
  [CompoundListCondition, None]
    [Assign x=4]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x << 1))"]
  [CompoundListCondition, None]
    [ArithmeticCommand "x <<= 1"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x + 0))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$x"]
  [CompoundListCondition, None]
    [Assign x=16]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x >> 2))"]
  [CompoundListCondition, None]
    [ArithmeticCommand "x >>= 2"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((x + 0))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$x"]
