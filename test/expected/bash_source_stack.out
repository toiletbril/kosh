[CompoundList]
  [CompoundListCondition, None]
    [Assign kosh_binary=$(koshkit realpath "$BIN")]
  [CompoundListCondition, None]
    [Assign d=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$d"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cat"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cat"]
  [CompoundListCondition, None]
    [SimpleCommand "$kosh_binary" "./main.sh"]
  [CompoundListCondition, None]
    [SimpleCommand "$kosh_binary" "--mood" "sh" "-c" "echo "sh-mood=[${BASH_SOURCE[0]}]""]
  [CompoundListCondition, None]
    [SimpleCommand "$kosh_binary" "-c" "echo "command-string=[$BASH_SOURCE] depth=[${#BASH_SOURCE[@]}]""]
  [CompoundListCondition, None]
    [Assign own_name=$("$kosh_binary" -c 'f() { echo "${BASH_SOURCE[0]}"; }; f')]
  [CompoundListCondition, None]
    [SimpleCommand "[" "$own_name" "=" "$kosh_binary" "]"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "command-string-function=own-name"]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "/"]
  [CompoundListCondition, None]
    [SimpleCommand "[" "-n" "$d" "]"]
  [CompoundListCondition, &&]
    [SimpleCommand "rm" "-r" "$d"]
[Word
  Unquoted "kosh_binary="
  CommandSubstitution "koshkit realpath "$BIN""
]
[Word
  Unquoted "d="
  CommandSubstitution "mktemp -d"
]
[Word
  Unquoted "cd"
]
[Word
  Variable "d"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "cat"
]
[Word
  Unquoted "lib.sh"
]
[Word
  Literal "EOF"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "cat"
]
[Word
  Unquoted "main.sh"
]
[Word
  Literal "EOF"
]
[Word
  Variable "kosh_binary"
]
[Word
  Unquoted "./main.sh"
]
[Word
  Variable "kosh_binary"
]
[Word
  Unquoted "--mood"
]
[Word
  Unquoted "sh"
]
[Word
  Unquoted "-c"
]
[Word
  Literal "echo "sh-mood=[${BASH_SOURCE[0]}]""
]
[Word
