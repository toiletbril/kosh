]
[Word
  Unquoted "-c"
]
[Word
  Literal "echo "command-string=[$BASH_SOURCE] depth=[${#BASH_SOURCE[@]}]""
]
[Word
  Unquoted "own_name="
  CommandSubstitution ""$kosh_binary" -c 'f() { echo "${BASH_SOURCE[0]}"; }; f'"
]
[Word
  Unquoted "["
]
[Word
  Variable "own_name"
]
[Word
