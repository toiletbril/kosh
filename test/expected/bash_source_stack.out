]
main-scalar=./main.sh
main[0]=./main.sh depth=1
lib-top=./lib.sh depth=2
sourcing-call=./lib.sh ./lib.sh ./main.sh depth=3
inner[0]=./lib.sh
inner[1]=./main.sh
inner-all=./lib.sh ./main.sh depth=2
inner-last=./main.sh
inner-past=[]
inner[0]=./lib.sh
inner[1]=./main.sh
inner-all=./lib.sh ./main.sh ./main.sh depth=3
inner-last=./main.sh
inner-past=[]
sh-mood=[]
command-string=[] depth=[0]
command-string-function=own-name
