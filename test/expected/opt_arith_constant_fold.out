[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((2+3*4))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$(( ((2+3)) * (4-1) ))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((10%3))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1<<4))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((2 ** 256))"]
  [CompoundListCondition, None]
    [CStyleForLoop "; 2 ** 64;"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "exact-loop"]
        [CompoundListCondition, None]
          [SimpleCommand "break"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--mood" "bash"]
  [CompoundListCondition, None]
    [CStyleForLoop "; 2 ** 64;"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "wrapped-loop"]
        [CompoundListCondition, None]
          [SimpleCommand "break"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after-loops"]
