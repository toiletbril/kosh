[CompoundList]
  [CompoundListCondition, None]
    [Assign file=$TEST_TEMP_DIRECTORY/redirection-truncate]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "first"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "second"]
  [CompoundListCondition, None]
    [SimpleCommand "cat"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$file"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "-o" "no-diagnostics"]
  [CompoundListCondition, None]
    [SimpleCommand "eval" "(umask 077; >| "$file")"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "compact-redirection=$([[ -f $file ]] && echo preserved)"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$file"]
[Word
  Unquoted "file="
  Variable "TEST_TEMP_DIRECTORY"
  Unquoted "/redirection-truncate"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "mkdir"
]
[Word
  Unquoted "-p"
]
[Word
  Variable "TEST_TEMP_DIRECTORY"
]
[Word
  Unquoted "echo"
]
[Word
  Unquoted "first"
]
[Word
  Variable "file"
]
[Word
  Unquoted "echo"
]
[Word
  Unquoted "second"
]
[Word
  Variable "file"
]
[Word
  Unquoted "cat"
]
[Word
  Variable "file"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "unlink"
]
[Word
  Variable "file"
]
[Word
  Unquoted "set"
]
[Word
  Unquoted "-o"
]
[Word
  Unquoted "no-diagnostics"
]
[Word
  Unquoted "eval"
]
[Word
  Literal "(umask 077; >| "$file")"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "compact-redirection="
  CommandSubstitution "[[ -f $file ]] && echo preserved"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "unlink"
]
[Word
  Variable "file"
]
first
second
compact-redirection=preserved
