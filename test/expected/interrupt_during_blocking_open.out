== an untrapped interrupt ends a blocking read open:
3:16: error: Interrupted.
     3 |  read -r line < "$fifo"
       |                 ^~~~~~~
1:1: error: Interrupted.
     1 |  fifo=$1
       |  ^
rc=130
== an untrapped interrupt ends a blocking write open:
3:16: error: Interrupted.
     3 |  echo payload > "$fifo"
       |                 ^~~~~~~
1:1: error: Interrupted.
     1 |  fifo=$1
       |  ^
rc=130
== an exec redirection reports the interrupt once:
3:9: error: Interrupted.
     3 |  exec 9< "$fifo"
       |          ^~~~~~~
rc=130
== wc buffers completed rows before an interrupted source:
1:1: error: Interrupted.
     1 |  directory=$1
       |  ^
rc=130
== cksum prints completed rows before an interrupted source:
2715464726 6 first
1:1: error: Interrupted.
     1 |  directory=$1
       |  ^
rc=130
== grep reads an earlier regular file before opening a later pipe:
grep-status=143
grep-first=printed
grep-interrupt=preserved
== diff stops after a first error before opening a later pipe:
3:1: error: diff: cannot read 'missing': No such file or directory.
     3 |  koshkit diff missing diff
       |  ^~~~~~~~~~~~~~~~~~~~~~~~~
diff-status=2
rc=0
timeout=no
== an ignored interrupt leaves the open blocked until its peer arrives:
kept=[payload] status=0
rc=0
