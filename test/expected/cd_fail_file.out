[CompoundList]
  [CompoundListCondition, None]
    [Assign start=$PWD]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY/cd-fail-file"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "$BIN" "-c" "cd "$TEST_TEMP_DIRECTORY/cd-fail-file/target""]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "$PWD" "=" "$start"]
  [CompoundListCondition, &&]
    [SimpleCommand "echo" "cwd=unchanged"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$TEST_TEMP_DIRECTORY/cd-fail-file/target"]
[Word
  Unquoted "start="
  Variable "PWD"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "mkdir"
]
[Word
  Unquoted "-p"
]
[Word
  Variable "TEST_TEMP_DIRECTORY"
  DoubleQuoted "/cd-fail-file"
]
[Word
  Unquoted ":"
]
[Word
  Variable "TEST_TEMP_DIRECTORY"
  DoubleQuoted "/cd-fail-file/target"
]
[Word
  Variable "BIN"
]
[Word
  Unquoted "-c"
]
[Word
  Literal "cd "$TEST_TEMP_DIRECTORY/cd-fail-file/target""
]
[Word
  Unquoted "2"
]
[Word
  Unquoted "/dev/null"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "after rc="
  Variable "?"
]
[Word
  Unquoted "test"
]
[Word
  Variable "PWD"
]
[Word
  Unquoted "="
]
[Word
  Variable "start"
]
[Word
  Unquoted "echo"
]
[Word
  DoubleQuoted "cwd=unchanged"
]
[Word
  Unquoted "koshkit"
]
[Word
  Unquoted "unlink"
]
[Word
  Variable "TEST_TEMP_DIRECTORY"
  DoubleQuoted "/cd-fail-file/target"
]
after rc=1
cwd=unchanged
