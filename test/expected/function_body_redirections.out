plain () 
{ echo hi; }
truncated () 
{ echo hi; } >/dev/null
paired () 
{ echo hi; } >/dev/null 2>&1
closed () 
{ :; } 2>&-
heredoc () 
{ cat; } <<EOF
herestring () 
{ cat; } <<< here
keyword () 
{ for i in 1 2; do :; done; } >/dev/null
