--- ls ---
a
nums.txt
--- ls a ---
b
--- file batched operands ---
nums.txt: text
stamp: empty
sym: text
1:33: error: file: cannot open 'missing.txt': No such file or directory.
     1 |  koshkit file nums.txt stamp sym missing.txt
       |                                  ^~~~~~~~~~~
file-status=1
--- custom file samples preserve merged-stream operand order ---
magic-good-a: batch-match
1:42: error: file: cannot open 'missing-magic': No such file or directory.
     1 |  koshkit file -M magic-batch magic-good-a missing-magic magic-good-b
       |                                           ^~~~~~~~~~~~~
magic-good-b: batch-match
custom-file-status=1
--- stat preserves nonadjacent repeated operands ---
nums.txt=6
stamp=0
nums.txt=6
--- stat preserves interleaved directory operands ---
batch-a/first=3
batch-b/third=5
batch-a/second=7
batch-b/fourth=9
--- ls -l sym (mode nlink size name) ---
lrwxrwxrwx 1 8 sym
--- ls after operations ---
a
batch-a
batch-b
moved.txt
nums.txt
stamp
sym
--- file signature variants ---
zip-span: ZIP archive
sqlite-wal: SQLite write-ahead log
netcdf-2: NetCDF data
netcdf-5: NetCDF data
pcap-le: pcap capture
pcap-ns-be: pcap capture
pcap-ns-le: pcap capture
cp-interactive-no=old
cp-interactive-yes=new
cp-preserve-mode=passed
cp-same-status=1 contents=same-file
cp-hardlink-status=1 contents=same-file
mv-interactive-no=old source=present
mv-interactive-yes=new source=missing
--- du -s nums.txt ---
du-file-allocation=matched
du-sparse-allocation=matched
--- du with no operand lists every entry and the total ---
du-order=descending
du-recursion=incomplete
--- du multiple roots ---
4096  du-default/a
4096  du-default/b
--- du equal-size roots ---
4096  du-default/tie-a
4096  du-default/tie-b
du-hardlinks=deduplicated
du-unreadable=ok
--- du interruption ---
du-interrupt=matched
--- basename ---
libfoo
--- dirname ---
/usr/local
--- realpath lexical basename ---
lib
--- ls a after rmdir ---
rmdir-parents=missing
--- unlink removes a single file ---
unlink rc=0
0
