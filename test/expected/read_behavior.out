rc=0 x=[hi]
rc=1 x=[h]
rc=1 x=[]
== a prefix IFS splits read after the global IFS was changed:
count=4 first=a last=d
== a prefix IFS splits read with the default global IFS:
x|y|z
== read without a prefix follows the changed global IFS:
count=3
== read -q returns zero for y:
rc=0
== read -q returns zero for Y:
rc=0
== read -q returns one for n:
rc=1
== read -q returns one for a non-y byte:
rc=1
== read -q at EOF returns one:
rc=1
== invalid read descriptors do not consume input:
status=1 kept=descriptor-kept
== invalid read counts do not consume input:
status=1 kept=count-kept
negative=1 kept=negative-kept
invalid=1
eof=1 value=[]
