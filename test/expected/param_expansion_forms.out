[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--" "a" "b" "c"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$@"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$#"]
  [CompoundListCondition, None]
    [Assign IFS=:]
