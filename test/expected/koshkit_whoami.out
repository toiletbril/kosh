[CompoundList]
  [CompoundListCondition, None]
    [Assign current_user=$(koshkit whoami)]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "nonempty=yes"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "nonempty=no"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "lines=$(koshkit whoami | koshkit wc -l)"]
  [CompoundListCondition, None]
    [Assign spoofed_user=$(LOGNAME=KOSH_FAKE USER=KOSH_FAKE koshkit whoami)]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "spoofed=no"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "spoofed=yes"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "effective=yes"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "effective=no"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "whoami" "--help"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "help=$?"]
[Word
  Unquoted "current_user="
  CommandSubstitution "koshkit whoami"
