[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$root/tree/child"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "640" "$root/mode"]
  [CompoundListCondition, None]
    [Assign mode_fields=$(koshkit ls -l "$root/mode")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-octal=$mode_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "u+x,g=u,o-r" "$root/mode"]
  [CompoundListCondition, None]
    [Assign mode_fields=$(koshkit ls -l "$root/mode")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-symbolic=$mode_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "-R" "a+rX" "$root/tree"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [Assign directory_status=$?]
  [CompoundListCondition, None]
    [Assign plain_fields=$(koshkit ls -l "$root/tree/plain")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-recursive=$directory_status $plain_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "444" "$root/omitted-who"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "+w" "$root/omitted-who"]
  [CompoundListCondition, None]
    [Assign omitted_fields=$(koshkit ls -l "$root/omitted-who")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-umask=$omitted_fields%% *"]
  [CompoundListCondition, None]
    [Assign uid=$UID]
  [CompoundListCondition, None]
    [Assign gid=$GROUPS[0]]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "$uid:$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown=$?"]
  [CompoundListCondition, None]
    [Assign owner_name=$(koshkit whoami)]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "$owner_name:$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-name=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$root/ownership/tree/child" "$root/ownership/loop/child"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "$root/ownership/missing" "$root/ownership/tree/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "$root/ownership/loop" "$root/ownership/loop/child/back"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-h" "$uid:$gid" "$root/ownership/tree/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-no-dereference=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "$uid:$gid" "$root/ownership/tree/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-dereference=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-P" "$uid:$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-physical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-H" "$uid:$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-arguments=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-H" "$uid:$gid" "$root/ownership/tree/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-argument-dereference=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-L" "$uid:$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-logical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-L" "-P" "$uid:$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-logical-physical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-P" "-L" "$uid:$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-physical-logical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "-R" "-L" "$uid:$gid" "$root/ownership/loop"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-loop=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "-h" "$gid" "$root/ownership/tree/broken"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp-no-dereference=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "-R" "-P" "$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp-physical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "-R" "-H" "$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp-arguments=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "-R" "-L" "$gid" "$root/ownership/tree"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp-logical=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "$root/mode" "$root/ln-symbolic"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "ln-symbolic=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "-m" "600" "$root/fifo"]
  [CompoundListCondition, None]
    [Assign fifo_fields=$(koshkit ls -l "$root/fifo")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo=$fifo_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "$root/fifo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo-existing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "-m" "a-w" "$root/read-only-fifo"]
  [CompoundListCondition, None]
    [Assign fifo_fields=$(koshkit ls -l "$root/read-only-fifo")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo-symbolic=$fifo_fields%% *"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "$TEST_SYSTEM_RM" "-rf" "--" "$root"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
]
