[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$root/tree/child"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "640" "$root/mode"]
  [CompoundListCondition, None]
    [Assign mode_fields=$(koshkit ls -l "$root/mode")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-octal=$mode_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "u+x,g=u,o-r" "$root/mode"]
  [CompoundListCondition, None]
    [Assign mode_fields=$(koshkit ls -l "$root/mode")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-symbolic=$mode_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "-R" "a+rX" "$root/tree"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [Assign directory_status=$?]
  [CompoundListCondition, None]
    [Assign plain_fields=$(koshkit ls -l "$root/tree/plain")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-recursive=$directory_status $plain_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "444" "$root/omitted-who"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chmod" "+w" "$root/omitted-who"]
  [CompoundListCondition, None]
    [Assign omitted_fields=$(koshkit ls -l "$root/omitted-who")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chmod-umask=$omitted_fields%% *"]
  [CompoundListCondition, None]
    [Assign uid=$UID]
  [CompoundListCondition, None]
    [Assign gid=$GROUPS[0]]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "$uid:$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown=$?"]
  [CompoundListCondition, None]
    [Assign owner_name=$(koshkit whoami)]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chown" "$owner_name:$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chown-name=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "chgrp" "$gid" "$root/mode"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "chgrp=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "link" "$root/mode" "$root/hard-link"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "link=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "link" "$root/mode" "$root/hard-link"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "link-existing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "-m" "600" "$root/fifo"]
  [CompoundListCondition, None]
    [Assign fifo_fields=$(koshkit ls -l "$root/fifo")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo=$fifo_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "$root/fifo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo-existing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkfifo" "-m" "a-w" "$root/read-only-fifo"]
  [CompoundListCondition, None]
    [Assign fifo_fields=$(koshkit ls -l "$root/read-only-fifo")]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "mkfifo-symbolic=$fifo_fields%% *"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-fields=$(koshkit df -Pk "$root" | koshkit tail -n 1 | koshkit wc -w)"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "df" "$root/missing"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-missing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "df"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-all=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "a_b.c-d"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-portable=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "a b"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-space=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-P" "--" "dir/-bad"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-hyphen=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "abcdefghijklmno"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-name-length=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-P" ""]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-empty=$?"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
]
