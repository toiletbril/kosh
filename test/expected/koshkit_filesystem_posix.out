chmod-octal=-rw-r-----
chmod-symbolic=-rwxrwx---
chmod-recursive=0 -rw-r--r--
chmod-umask=-rw-r--r--
chown=0
chown-name=0
chgrp=0
link=0
link-existing=1
mkfifo=prw-------
mkfifo-existing=1
mkfifo-symbolic=pr--r--r--
df-fields=6
df-missing=1
df-all=0
pathchk-portable=0
pathchk-space=1
pathchk-hyphen=1
pathchk-name-length=1
pathchk-empty=1
