[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo hi" "INT"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "INT"]
  [CompoundListCondition, None]
    [SimpleCommand "trap"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "done"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo got_int" "INT"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "2"]
  [CompoundListCondition, None]
    [SimpleCommand "trap"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cleared_by_number"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo got_term" "15"]
  [CompoundListCondition, None]
    [SimpleCommand "trap"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "set_by_number"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "printf "quoted=<%s>\n" "a'b"" "EXIT"]
  [CompoundListCondition, None]
    [Assign trap_file=$TEST_TEMP_DIRECTORY/kosh-trap-replay-$$]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-p" "EXIT"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-" "EXIT"]
  [CompoundListCondition, None]
    [Assign listed=$(koshkit cat "$trap_file")]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$trap_file"]
  [CompoundListCondition, None]
    [SimpleCommand "eval" "$listed"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "-p" "EXIT"]
