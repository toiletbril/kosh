[CompoundList]
  [CompoundListCondition, None]
    [Assign value=$(( 2 ** 9999 ))]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$#value"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$value:0:20"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$value: -20"]
  [CompoundListCondition, None]
    [Assign negative=$((-(2 ** 9999)))]
  [CompoundListCondition, None]
    [Assign negative_copy=$((negative))]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "negative=%s:%s:%s\n" "$negative_copy:0:1" "$#negative_copy" "$negative_copy: -20"]
  [CompoundListCondition, None]
    [Assign formula=value]
  [CompoundListCondition, None]
    [FunctionDefinition "promoted_step"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "local" "chosen" "previous" "combined"]
          [CompoundListCondition, None]
            [Assign chosen=$((1 ? formula + iteration + 1 : 0))]
          [CompoundListCondition, None]
            [Assign previous=$((chosen++))]
          [CompoundListCondition, None]
            [Assign combined=$((previous, chosen))]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [ArithmeticCommand "previous != formula + iteration + 1 ||
      chosen != formula + iteration + 2 || combined != chosen"]
              [CompoundList]
                [CompoundListCondition, None]
                  [Assign lifetime=bad]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [ArithmeticCommand "iteration == 255"]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "previous=%s:%s\n" "$#previous" "$previous: -20"]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "chosen=%s:%s\n" "$#chosen" "$chosen: -20"]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "combined=%s:%s\n" "$#combined" "$combined: -20"]
  [CompoundListCondition, None]
    [Assign iteration=0]
  [CompoundListCondition, None]
    [Assign lifetime=ok]
  [CompoundListCondition, None]
    [WhileLoop]
      [CompoundList]
        [CompoundListCondition, None]
          [ArithmeticCommand "iteration < 256"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "promoted_step"]
        [CompoundListCondition, None]
          [Assign iteration=$((iteration + 1))]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "lifetime=$lifetime"]
