[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$TEST_TEMP_DIRECTORY/koshkit-filesystem-portable]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "$TEST_SYSTEM_RM" "-rf" "--" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "link" "$root/source" "$root/hard-link"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "link=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "link" "$root/source" "$root/hard-link"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "link-existing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "$root/source" "$root/ln-hard"]
  [CompoundListCondition, None]
    [ConditionalCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "ln-hard=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-fields=$(koshkit df -Pk "$root" | koshkit tail -n 1 | koshkit wc -w)"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "df" "$root/missing"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-missing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "df"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "df-all=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "a_b.c-d"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-portable=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "a b"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-space=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-P" "--" "dir/-bad"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-hyphen=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-p" "abcdefghijklmno"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-name-length=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pathchk" "-P" ""]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "pathchk-empty=$?"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [ConditionalCommand]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "$TEST_SYSTEM_RM" "-rf" "--" "$root"]
