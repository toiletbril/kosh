help-status=0
help-auxiliary=yes
if [ -f "$x" ]
then
  echo yes
else
  echo no
fi
#!/bin/sh
# keep this text without wrapping
if true
then
  echo x # preserve this inline comment
  # this standalone comment stays longer than eighty columns without being wrapped or shortened
  cat <<-BODY
	body $x
	BODY
fi
[ -n "$x" ]
test ()
{
  echo shadow
}
test -n "$x"
command test -n "$x"
value=$(if [ -n "$1" ]
  then
    echo yes
  else
    echo no
  fi)
idempotent=yes
printf one two three four five six seven eight nine ten eleven twelve thirteen \
  fourteen fifteen sixteen
wrap-idempotent=yes maximum=80
echo {a,b}
items=(one two)
for ((i=0; i<2; i++))
do
  echo "$i"
done
echo @(a|b)
printf "%s\n" if test x = x
printf "%s\n" ! test x = y
case x
in
  test)
    echo yes
  ;;
esac
[ -n "$x" ] # keep
[ -f x ] 2>/dev/null
2>/dev/null [ -n x ]
printf err >&2
exec 3>&1
(
  echo sub
)
if [[ $exits > 0 ]]
then
  exit 1
fi
nested-idempotent=yes
if cat <<EOF
body
EOF
then
  echo done
fi
if cat <<EOF
body
EOF
then # keep
  echo done
fi
printf then <<EOF
body
EOF
if
{
  true
} &&
{
  false
} || true
then
  :
fi || false
case x
in
  x)
    :
  ;;
esac | cat
case x
in
  x)
    echo arm
esac
echo top
if true
then
  echo dash
fi
continuation-equivalent=yes idempotent=yes
lone-cr-retained=yes idempotent=yes
x+=1 [ -n "$x" ]
arr[0]=v [ -n "${arr[0]}" ]
arr[1]+=w [ -n "${arr[1]}" ]
assignment-prefixes-idempotent=yes
nested-heredoc-equivalent=yes idempotent=yes
apply-status=0 executable=yes symlink=yes
for x in a b
do
  [ "$x" = a ] && echo "$x"
done
if true
then
  echo second
fi
hardlink-retained=yes
clean-crlf-status=0 retained=yes
fixed-crlf-status=0 retained=yes
lint-apply-status=1 contents=#!/bin/sh|[ "$1" = y ]|printf "%s\n" $1 $@|
combined-status=1
#!/bin/bash
if [ -n "$1" ]
then
  [ "$1" = y ]
fi
if [[ $1 > 0 ]]
then
  echo positive
fi
warning-apply-status=1
#!/bin/bash
[[ 1 > 0 ]]
safe-and-unsafe-status=1 contents=#!/bin/sh|[ "$1" = y ]|printf "%s\n" $1|
parse-status=1 unchanged=yes
lint-parse-status=1 unchanged=yes
combined-parse-status=1 unchanged=yes
apply-alone-status=2
multi-stdout-status=2
lint-format-stdout-status=0
#!/bin/sh
if [ -n "$1" ]
then
  [ "$1" = y ]
fi
apply-conflicts=2,2,2 unchanged=yes
nonregular-status=1
environment-options-filtered
