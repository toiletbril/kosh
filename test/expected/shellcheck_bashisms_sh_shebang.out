[CompoundList]
  [CompoundListCondition, None]
    [FunctionDefinition "lint_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "-e" "escaped"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "-n" "nonewline"]
          [CompoundListCondition, None]
            [SimpleCommand "declare" "-A" "assoc"]
          [CompoundListCondition, None]
            [SimpleCommand "typeset" "scoped"]
          [CompoundListCondition, None]
            [SimpleCommand "source" "library.sh"]
  [CompoundListCondition, None]
    [FunctionDefinition "word_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "cat" "<echo substituted"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "!(excluded)"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "a	b"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "[^a]tail"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$(<file)"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$(<file)"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$!indirect"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$array[0]"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$!array[@]"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$!prefix*"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$text:1:2"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$text/from/to"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$RANDOM"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$text:-default"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$#text"]
  [CompoundListCondition, None]
    [FunctionDefinition "redirect_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "both"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "append"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "dup"]
          [CompoundListCondition, None]
            [SimpleCommand "exec"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "high"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "net"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "glob"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "plain"]
  [CompoundListCondition, None]
    [FunctionDefinition "operator_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [ArithmeticCommand "counter + 1"]
          [CompoundListCondition, None]
            [SimpleCommand ":" "$((counter++))"]
          [CompoundListCondition, None]
            [SimpleCommand ":" "$((counter--))"]
          [CompoundListCondition, None]
            [SimpleCommand ":" "$((base ** exponent))"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "alpha" "<" "beta" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "alpha" ">" "beta" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "first" "-nt" "second" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "first" "-ef" "second" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-a" "present" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "alpha" "=" "beta" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-e" "present" "]"]
  [CompoundListCondition, None]
    [FunctionDefinition "timed_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "printf" "timed\n"]
              [SimpleCommand "wc" "-l"]
          [CompoundListCondition, None]
            [BraceGroup]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "grouped\n"]
          [CompoundListCondition, None]
            [Subshell]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "subshell\n"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "plain\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "command_only"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Assign LIST+=extra]
          [CompoundListCondition, None]
            [SimpleCommand "env"]
          [CompoundListCondition, None]
            [SimpleCommand "exec" "-c" "env"]
          [CompoundListCondition, None]
            [SimpleCommand "let" "value=1"]
          [CompoundListCondition, None]
            [SimpleCommand "trap" "cleanup" "ERR"]
          [CompoundListCondition, None]
            [SimpleCommand "trap" "cleanup" "SIGINT"]
          [CompoundListCondition, None]
            [SimpleCommand "trap" "cleanup" "int"]
          [CompoundListCondition, None]
            [SimpleCommand "trap" "cleanup" "INT"]
          [CompoundListCondition, None]
            [SimpleCommand "trap" "cleanup" "EXIT"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "%q\n" "$value"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "%s\n" "$value"]
          [CompoundListCondition, None]
            [SimpleCommand "." "library.sh" "extra"]
          [CompoundListCondition, None]
            [SimpleCommand "." "library.sh"]
  [CompoundListCondition, None]
    [FunctionDefinition "positional_zero_assignment"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "$0=zero"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "done"]
