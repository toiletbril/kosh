[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "command" "-v" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "command" "-v" "set"]
  [CompoundListCondition, None]
    [Assign d=$TEST_TEMP_DIRECTORY/command-v-golden]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$d"]
  [CompoundListCondition, None]
    [Assign probe_file=$d/probe]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "[" "$OS-" "=" "Windows_NT" "]"]
      [CompoundList]
        [CompoundListCondition, None]
          [Assign probe_file=$probe_file.exe]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cp" "$BIN" "$probe_file"]
  [CompoundListCondition, None]
    [Assign PATH=$d]
  [CompoundListCondition, None]
    [FunctionDefinition "probe"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "function_probe"]
  [CompoundListCondition, None]
    [SimpleCommand "command" "-v" "probe"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "rm" "-rf" "$d"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== command -v guard:"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "command" "-v" "nonexistent-tool-xyz"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "tool is required"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== command -v if/then/else:"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "command" "-v" "nonexistent-tool-xyz"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "nonexistent-tool-xyz" "run"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "tool not installed"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== type guard:"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "type" "nonexistent-tool-abc"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "need abc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== hash guard:"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "hash" "nonexistent-tool-def"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "need def"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== dead branch if false:"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "start"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "false"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "totally-nonexistent-command"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "end"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== unguarded still errors:"]
  [CompoundListCondition, None]
    [SimpleCommand "totally-nonexistent-command"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
