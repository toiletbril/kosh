[CompoundList]
  [CompoundListCondition, None]
    [FunctionDefinition "assignment_value_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "local" "counter=0"]
          [CompoundListCondition, None]
            [Assign counter=$counter+1]
          [CompoundListCondition, None]
            [Assign counter=counter+1]
          [CompoundListCondition, None]
            [Assign PATH=/opt/local/bin]
          [CompoundListCondition, None]
            [Assign pattern=*.txt]
          [CompoundListCondition, None]
            [Assign braces=file{a,b}.txt]
  [CompoundListCondition, None]
    [FunctionDefinition "assignment_pipeline_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand]
              [SimpleCommand "wc" "-l"]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand]
              [SimpleCommand "wc" "-l"]
          [CompoundListCondition, None]
            [SimpleCommand "x\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "array_name_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$entries"]
          [CompoundListCondition, None]
            [Assign entries=scalar]
          [CompoundListCondition, None]
            [Assign entries+=tail]
          [CompoundListCondition, None]
            [Assign grid[1][2]=corner]
          [CompoundListCondition, None]
            [SimpleCommand]
          [CompoundListCondition, None]
            [SimpleCommand "declare" "-a" "declared"]
          [CompoundListCondition, None]
            [Assign declared=flat]
          [CompoundListCondition, None]
            [SimpleCommand "mapfile" "-t" "filled"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$filled"]
  [CompoundListCondition, None]
    [FunctionDefinition "quoted_value_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Assign options=-t "one two"]
          [CompoundListCondition, None]
            [SimpleCommand "wc" "$options"]
  [CompoundListCondition, None]
    [FunctionDefinition "command_word_shape_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "onetwothree"]
          [CompoundListCondition, None]
            [SimpleCommand ":" "$SANDWICH:=fallback"]
          [CompoundListCondition, None]
            [Assign same=1]
          [CompoundListCondition, None]
            [Assign same=$same]
          [CompoundListCondition, None]
            [Assign IFS=\t]
          [CompoundListCondition, None]
            [Assign pager=cat]
          [CompoundListCondition, None]
            [SimpleCommand "$1=first"]
          [CompoundListCondition, None]
            [SimpleCommand "$0=zero"]
          [CompoundListCondition, None]
            [SimpleCommand "prefix$suffix=1"]
          [CompoundListCondition, None]
            [SimpleCommand "odd.name==value"]
          [CompoundListCondition, None]
            [SimpleCommand "==="]
          [CompoundListCondition, None]
            [SimpleCommand "===trail"]
          [CompoundListCondition, None]
            [SimpleCommand "=lead"]
          [CompoundListCondition, None]
            [SimpleCommand "$quoted=42"]
          [CompoundListCondition, None]
            [SimpleCommand "9lives=cat"]
          [CompoundListCondition, None]
            [SimpleCommand "spaced" "+=" "tail"]
  [CompoundListCondition, None]
    [FunctionDefinition "redirection_semantics_diagnostics"]
      [BraceGroup]
