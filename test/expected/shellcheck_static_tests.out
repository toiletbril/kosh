[CompoundList]
  [CompoundListCondition, None]
    [FunctionDefinition "recursive_wrapper"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "recursive_wrapper" "$@"]
  [CompoundListCondition, None]
    [FunctionDefinition "test_operator_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "let" "counter -lt limit"]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" ">=" "$right" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "-foo" "$right" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-foo" "$right" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "-gt" "1.5" "]"]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "-gt" "count+1" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "recursive_wrapper" "==" "value"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-5" "-gt" "3" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "--help" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-verbose" "=" "$left" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-e" "$left" "-a" "-e" "$right" "]"]
  [CompoundListCondition, None]
    [FunctionDefinition "constant_test_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
