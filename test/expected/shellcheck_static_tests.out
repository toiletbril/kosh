          [CompoundListCondition, None]
            [SimpleCommand "[" "1" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "literal" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$(ls)" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-n" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "a" "=" "b" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "=" "b" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "!=" "a" "-o" "$left" "!=" "b" "]"]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "!=" "a" "]"]
          [CompoundListCondition, ||]
            [SimpleCommand "[" "$left" "!=" "b" "]"]
          [CompoundListCondition, None]
            [ConditionalCommand]
  [CompoundListCondition, None]
    [FunctionDefinition "test_grouping_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "=" "a"]
          [CompoundListCondition, &&]
            [SimpleCommand "$right" "=" "b" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "=" "a"]
          [CompoundListCondition, ||]
            [SimpleCommand "$right" "=" "b" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "trailing" "]"]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$left" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "written"]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [Subshell]
                    [CompoundList]
                      [CompoundListCondition, None]
                        [SimpleCommand "-f" "$left"]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "echo" "found"]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [Subshell]
                    [CompoundList]
                      [CompoundListCondition, None]
                        [SimpleCommand "[" "-f" "$left" "]"]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "echo" "found"]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [Subshell]
                    [CompoundList]
                      [CompoundListCondition, None]
                        [ConditionalCommand]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "echo" "found"]
  [CompoundListCondition, None]
    [FunctionDefinition "test_operand_expansion_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$@" "=" "one" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "$values[@]" "=" "one" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "{a,b}" "=" "one" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "*.txt" "=" "one" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-d" "*.txt" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-v" "arr[i]" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-n" "$value" "]"]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
          [CompoundListCondition, None]
            [ConditionalCommand]
  [CompoundListCondition, None]
    [FunctionDefinition "file_command_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "ls"]
              [SimpleCommand "xargs" "rm"]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "ls"]
              [SimpleCommand "wc" "-l"]
          [CompoundListCondition, None]
            [SimpleCommand "find" "-name" "*.txt"]
          [CompoundListCondition, None]
            [SimpleCommand "mv" "file.txt"]
          [CompoundListCondition, None]
            [SimpleCommand "cp" "-r" "dir"]
          [CompoundListCondition, None]
            [SimpleCommand "ln" "-s" "target"]
          [CompoundListCondition, None]
            [SimpleCommand "xargs" "-i" "echo" "replaced"]
  [CompoundListCondition, None]
    [FunctionDefinition "text_utility_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "echo" "$value"]
              [SimpleCommand "wc" "-c"]
          [CompoundListCondition, None]
            [SimpleCommand "sed" "s/old/new/" "file"]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "true"]
              [SimpleCommand "ls"]
          [CompoundListCondition, None]
            [SimpleCommand "find" "." "-exec" "echo" "$(basename x)" ";"]
          [CompoundListCondition, None]
            [SimpleCommand "tr" "a-z" "A-Z"]
          [CompoundListCondition, None]
            [SimpleCommand "tr" "hello" "world"]
          [CompoundListCondition, None]
            [SimpleCommand "grep" "file*" "list"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "line\n"]
          [CompoundListCondition, None]
            [SimpleCommand "[" "-n" "$(grep needle file)" "]"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "plain\n" "one" "two"]
  [CompoundListCondition, None]
    [FunctionDefinition "helper_function"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "helper"]
  [CompoundListCondition, None]
    [FunctionDefinition "privilege_and_builtin_diagnostics"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "ssh" "remote" "echo $value"]
          [CompoundListCondition, None]
            [SimpleCommand "ssh" "-p" "22" "remote" "echo $value"]
          [CompoundListCondition, None]
            [SimpleCommand "ssh" "remote" "echo literal"]
          [CompoundListCondition, None]
            [SimpleCommand "su" "operator" "helper_function"]
          [CompoundListCondition, None]
            [SimpleCommand "su" "-" "-c" "helper_function"]
          [CompoundListCondition, None]
            [SimpleCommand "su" "operator" "whoami"]
          [CompoundListCondition, None]
            [SimpleCommand "find" "." "-exec" "helper_function" "{}" ";"]
          [CompoundListCondition, None]
            [SimpleCommand "find" "." "-execdir" "helper_function" "{}" ";"]
          [CompoundListCondition, None]
            [Pipeline]
              [SimpleCommand "ls"]
              [SimpleCommand "xargs" "helper_function"]
          [CompoundListCondition, None]
            [SimpleCommand "cd" "/tmp"]
          [CompoundListCondition, None]
            [SimpleCommand "cd" "-"]
          [CompoundListCondition, None]
            [SimpleCommand "break"]
          [CompoundListCondition, None]
            [SimpleCommand "set" "assigned=value"]
          [CompoundListCondition, None]
            [SimpleCommand "return" "one" "two"]
          [CompoundListCondition, None]
            [SimpleCommand "exit" "one" "two"]
          [CompoundListCondition, None]
            [SimpleCommand "return" "$(echo 5)"]
          [CompoundListCondition, None]
            [SimpleCommand "export" "$exported_name"]
          [CompoundListCondition, None]
            [SimpleCommand "sudo" "cd" "/tmp"]
          [CompoundListCondition, None]
            [SimpleCommand "sudo" "export" "FOO=1"]
  [CompoundListCondition, None]
