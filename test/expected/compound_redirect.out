[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY"]
  [CompoundListCondition, None]
    [Assign redirect_file=$TEST_TEMP_DIRECTORY/compound-redirect]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "hi"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$redirect_file"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "back"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "a"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "b"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "wc" "-l"]
      [SimpleCommand "tr" "-d" " "]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [ForLoop "n"]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "$n"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$redirect_file"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [IfClause]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "true"]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "y"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$redirect_file"]
