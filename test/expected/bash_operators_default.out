[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY"]
  [CompoundListCondition, None]
    [Assign amp_file=$TEST_TEMP_DIRECTORY/bash-operators-amp]
  [CompoundListCondition, None]
    [Pipeline]
      [RedirectedCommand]
        [SimpleCommand "echo" "through"]
      [SimpleCommand "cat"]
  [CompoundListCondition, None]
    [Pipeline]
      [RedirectedCommand]
        [BraceGroup]
          [CompoundList]
            [CompoundListCondition, None]
              [SimpleCommand "echo" "to-err"]
      [SimpleCommand "cat"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "both"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$amp_file"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "more"]
  [CompoundListCondition, None]
    [SimpleCommand "cat" "$amp_file"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$amp_file"]
[Word
  Unquoted "koshkit"
]
