[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\ntwo\nthree\nfour\nfive\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\nTWO\nthree\nfour\nfive\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "left" "left"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "equal=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "--label" "left" "--label" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "unified=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "normal=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a  b\r\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a b\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-w" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "whitespace=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "left"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "missing-newline=$?"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "added\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "insertion=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "right" "-L" "left" "right" "left"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "deletion=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\0b\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\0c\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "binary=$?"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "koshkit" "diff" "-a" "-u" "-L" "left" "-L" "right" "left" "right"]
      [SimpleCommand "koshkit" "wc" "-c"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "text=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "same\n"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "same\n"]
      [SimpleCommand "koshkit" "diff" "-" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "stdin=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "+o" "pipefail"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "same\n"]
      [SimpleCommand "koshkit" "diff" "-" "-"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "double-stdin=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "-o" "pipefail"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\na\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "b\na\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "repeated=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\nthree\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\ntwo\nthree\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "middle-insertion=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "right" "-L" "left" "right" "left"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "middle-deletion=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "old-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nold-2\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "new-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nnew-2\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "merged-hunks=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "old-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nkeep-7\nold-2\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "new-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nkeep-7\nnew-2\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "-u" "-L" "left" "-L" "right" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "separate-hunks=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "same"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "same"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "left" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "equal-no-newline=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "diff" "absent" "right"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "missing=$?"]
