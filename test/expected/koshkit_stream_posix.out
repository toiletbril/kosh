[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "Cat\n"]
      [SimpleCommand "koshkit" "uuencode" "animal.txt"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "begin 644 decoded.txt" "$0V%T"@``" "`" "end"]
      [SimpleCommand "koshkit" "uudecode"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cat" "decoded.txt"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "one two three\n"]
      [SimpleCommand "koshkit" "xargs" "-n" "1" "printf" "<%s>\n"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "'hello world' plain\ value\n"]
      [SimpleCommand "koshkit" "xargs" "printf" "[%s]\n"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "one\ntwo\n"]
      [SimpleCommand "koshkit" "xargs" "-I" "{}" "printf" "x%sx\n" "{}"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
]
