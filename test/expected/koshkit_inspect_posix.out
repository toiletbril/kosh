[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hello\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\0abcde\0xy\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "empty" "text" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-i" "empty" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "text" "text-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "absent" "broken-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "text-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-h" "text-link" "broken-link"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "file" "absent"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "file-missing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string \x97\x4A\x42\x32 image data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string \x97 fallback data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string no no-match"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\227JB2"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-a" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-a" "-m" "magic-b" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-zero" "-m" "magic-b" "-M" "magic-a" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC <10 small" "0 uC >10 large"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\005"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\024"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-number" "magic-low" "magic-high"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC&0x0f 5 masked"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\025"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-mask" "magic-masked"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC 5 value-is-%d"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-format" "magic-low"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC 1 parent" ">1 uC &0x80 child"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\001\200"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-continuation" "magic-child"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "invalid line" "0 string hello greeting"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hello"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-malformed" "magic-hello"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "strings" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "strings" "-n" "2" "-t" "d" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-An" "-tx1" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-An" "-tc" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "1234567890abcdef1234567890abcdef"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-A" "n" "-t" "x1" "repeated"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-v" "-A" "n" "-t" "x1" "repeated"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-A" "n" "-t" "c" "text" "+1"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
