[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hello\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\0abcde\0xy\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "empty" "text" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-i" "empty" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "text" "text-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "absent" "broken-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "text-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-h" "text-link" "broken-link"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "file" "absent"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "file-missing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string \x97\x4A\x42\x32 image data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string \x97 fallback data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string no no-match"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\227JB2"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-a" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-a" "-m" "magic-b" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-zero" "-m" "magic-b" "-M" "magic-a" "magic-data"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC <10 small" "0 uC >10 large"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\005"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\024"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-number" "magic-low" "magic-high"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC&0x0f 5 masked"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\025"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-mask" "magic-masked"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC 5 value-is-%d"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-format" "magic-low"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 uC 1 parent" ">1 uC &0x80 child"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\001\200"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-continuation" "magic-child"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "invalid line" "0 string hello greeting"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hello"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-malformed" "magic-hello"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "9000 string MARK far-string"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "head" "-c" "9000" "/dev/zero"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "MARK"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "head" "-c" "9000" "/dev/zero"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "MAR"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-far" "magic-far-exact" "magic-far-short"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "10000 uC 7 far-number"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "head" "-c" "10000" "/dev/zero"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\007"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-far-number" "magic-number-data"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-m" "magic-zero" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "65534 string A end-65535" "65535 string B end-65536" "65536 string C end-65537"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "A"]
      [SimpleCommand "dd" "of=magic-end-65535" "bs=1" "seek=65534"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "B"]
      [SimpleCommand "dd" "of=magic-end-65536" "bs=1" "seek=65535"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "C"]
      [SimpleCommand "dd" "of=magic-end-65537" "bs=1" "seek=65536"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-boundaries" "magic-end-65535" "magic-end-65536" "magic-end-65537"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "0 string M parent" ">70000 string Z child"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "M"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "Z"]
      [SimpleCommand "dd" "of=magic-continuation-data" "bs=1" "seek=70000" "conv=notrunc"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-far-continuation" "magic-continuation-data"]
  [CompoundListCondition, None]
    [SimpleCommand "dd" "if=/dev/zero" "of=magic-sparse" "bs=1" "count=1" "seek=1073741823"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "MARK"]
      [SimpleCommand "dd" "of=magic-sparse" "bs=1" "seek=9000" "conv=notrunc"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-far" "magic-sparse"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "9000 string Z far-no-match"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "koshkit" "yes" "A"]
      [SimpleCommand "koshkit" "tr" "-d" "\n"]
      [SimpleCommand "koshkit" "head" "-c" "9000"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\0"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-m" "magic-far-default" "magic-default-data"]
  [CompoundListCondition, None]
