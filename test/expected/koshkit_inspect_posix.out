  [CompoundListCondition, None]
    [SimpleCommand "printf" "M"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-batch" "empty" "magic-short" "magic-fifo"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "MATCH"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-batch" "--" "-"]
  [CompoundListCondition, None]
    [Assign format_rows=png|\211PNG\r\n\032\n
jpeg|\377\330\377
gzip|\037\213
xz|\3757zXZ\0
zip|PK\003\004
pdf|%PDF-
sqlite|SQLite format 3\0
wasm|\0asm
llvm|BC\300\336
java|\312\376\272\276\0\0\0\075
universal|\312\376\272\276\0\0\0\001
webp|RIFF\0\0\0\0WEBP
avif|\0\0\0\0ftypavif
matroska|\032E\337\243matroska
flac|fLaC
ogg|OggS
midi|MThd\0\0\0\006
postgres|PGDMP
git-pack|PACK
flash|FWS]
  [CompoundListCondition, None]
    [Assign old_ifs=$IFS]
  [CompoundListCondition, None]
    [Assign IFS=
]
  [CompoundListCondition, None]
    [ForLoop "format_row"]
      [CompoundList]
        [CompoundListCondition, None]
          [Assign format_name=$format_row%%|*]
        [CompoundListCondition, None]
          [Assign format_bytes=$format_row#*|]
        [CompoundListCondition, None]
          [SimpleCommand "printf" "%b" "$format_bytes"]
  [CompoundListCondition, None]
    [Assign IFS=$old_ifs]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "png" "jpeg" "gzip" "xz" "zip" "pdf" "sqlite" "wasm" "llvm" "java" "universal" "webp" "avif" "matroska" "flac" "ogg" "midi" "postgres" "git-pack" "flash"]
