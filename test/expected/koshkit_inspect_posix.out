empty: empty
text: text
binary: data
empty: regular file
text: regular file
text-link: text
text-link: symbolic link to text
broken-link: symbolic link to absent
file-missing=1
magic-data: image data
magic-data: image data
magic-data: fallback data
magic-low: small
magic-high: large
magic-masked: masked
magic-low: value-is-5
magic-child: parent child
magic-hello: greeting
abcde
      1 abcde
      7 xy
        68 65 6c 6c 6f 0a
          h   e   l   l   o  \n
        31 32 33 34 35 36 37 38 39 30 61 62 63 64 65 66
*
        31 32 33 34 35 36 37 38 39 30 61 62 63 64 65 66
        31 32 33 34 35 36 37 38 39 30 61 62 63 64 65 66
          e   l   l   o  \n
