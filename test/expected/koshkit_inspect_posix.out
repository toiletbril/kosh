[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "hello\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\0abcde\0xy\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "empty" "text" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "strings" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "strings" "-n" "2" "-t" "d" "binary"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-An" "-tx1" "text"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "od" "-An" "-tc" "text"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
]
