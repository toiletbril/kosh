  [CompoundListCondition, None]
    [SimpleCommand "printf" "MATCH"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-m" "magic-batch" "magic-m-option"]
  [CompoundListCondition, None]
    [ForLoop "batch_index"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "printf" "MATCH"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-batch" "magic-probe-*"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "file" "-M" "magic-batch" "magic-probe-01" "absent" "magic-probe-18"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "file-magic-missing=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "ln" "-s" "magic-far-exact" "magic-far-link"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "file" "-M" "magic-far" "magic-far-link"]
  [CompoundListCondition, None]
