[CompoundList]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "scale=2; 1/8\n2^10\n"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-core"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "/* ignored */" "a=2" "b=3" "b" "a" "missing" "a+=5.47" "a"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" ""line string"" "scale(123.450)" "length(123.450)" "sqrt(2)" "scale=10" "sqrt(2)"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-bases"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "ibase=2" "1011.01" "ibase=A" "obase=16" "255"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-control"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "if(1) 2" "if(0) 3" "for(i=0;i<3;i++) i" "i=0" "while(i<3) ++i" "while(1) break" "if(0) quit" "9"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-functions"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "define add(a,b) { return(a+b) }" "define local(a) { auto x; x=9; a=7; return(x+a) }" "g=5" "add(2,3)" "local(g)" "g" "arr[0]=4" "arr[1]=6" "define mutate(a[]) { a[0]; a[0]=8 }" "mutate(arr[])" "arr[0]"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "define x(x,y) { return(x-y+5) }" "define y(y,x) { return(x(y,x)+x(x,y)) }" "y(1,4)"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "10^70"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-continuation"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "1\\\n2\n0.\\\n345\n"]
      [SimpleCommand "koshkit" "bc"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "bc-math"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "%s\n" "scale=12" "s(1)" "c(1)" "a(1)" "l(2)" "e(1)"]
      [SimpleCommand "koshkit" "bc" "-l"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expr" "2" "+" "3" "*" "4"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expr" "7" ">" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expr" "abc" ":" "a\(.*\)"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expr" "0" "|" "hello"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expr" "0"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "expr-false=$?"]
