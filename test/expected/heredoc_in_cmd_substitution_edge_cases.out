[CompoundList]
  [CompoundListCondition, None]
    [Assign x=$(cat <<\EOF
backslash escaped delimiter
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$x"]
  [CompoundListCondition, None]
    [Assign y=$(cat <<FOO-BAR
bareword with dash
FOO-BAR
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$y"]
  [CompoundListCondition, None]
    [Assign z=$(cat <<   EOF
leading whitespace before delimiter
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$z"]
  [CompoundListCondition, None]
    [Assign w=$(echo pre; cat <<EOF
semicolon sentinel
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$w"]
  [CompoundListCondition, None]
    [Assign v=$(true && cat <<-EOF
	tab stripped in substitution
	EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$v"]
  [CompoundListCondition, None]
    [Assign x=$(cat <<EOF
body
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$x"]
  [CompoundListCondition, None]
    [Assign y=$(cat <<EOF
first line
second line
third line
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$y"]
  [CompoundListCondition, None]
    [ForLoop "i"]
      [CompoundList]
        [CompoundListCondition, None]
          [Assign z=$(cat <<EOF
iteration $i
EOF
)]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "$z"]
  [CompoundListCondition, None]
    [Assign HOME=/testhome]
  [CompoundListCondition, None]
    [Assign x=$(cat <<EOF
body
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$x"]
  [CompoundListCondition, None]
    [Assign y=$(cat <<'EOF'
a " b
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$y"]
  [CompoundListCondition, None]
    [Assign z=$(cat <<EOF
$HOME
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$z"]
  [CompoundListCondition, None]
    [Assign w=$(echo pre; cat <<EOF
mid
EOF
echo post)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$w"]
  [CompoundListCondition, None]
    [Assign t=$(cat <<'EOF'
has `backticks` and $vars
EOF
)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$t"]
[Word
  Unquoted "x="
  CommandSubstitution "cat <<\EOF
backslash escaped delimiter
EOF
"
]
