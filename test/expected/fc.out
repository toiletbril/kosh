== list ranges and order ==
	 echo alpha
	 echo old-old
	 false
	 false
	 echo old-old
	 echo alpha
	 echo alpha
	 echo old-old
	 echo alpha
	 echo old-old
	 false
	 echo alpha
	 echo alpha
	 false
== execute and substitute ==
echo new-new
new-new
rc=0
	 echo alpha
	 echo old-old
	 echo new-new
echo new-new
new-new
rc=0
echo old-old
old-old
rc=0
false
rc=1
== editor selection and current shell ==
edited_value=explicit
explicit
edited_value=fcedit
fcedit
edited_value=editor
editor
edited_value=vi
vi
edited_value=ed
ed
editor-rc=1
return 7
edit-return-rc=7
history -c
echo after-clear
history
after-clear
    1  echo after-clear
    2  history
== multiline history ==
	 echo first
echo second
echo first
echo second
first
second
== selection errors ==
111:7: error: Builtin `fc`: no command found.
   111 |  fc -s missing-prefix
       |        ^~~~~~~~~~~~~~
missing-rc=1
113:7: error: Builtin `fc`: no command found.
   113 |  fc -s -0
       |        ^~
zero-rc=1
return 7
fc:1:1: error: Builtin `return`: can only `return' from a function or sourced script.
     1 |  return 7
       |  ^~~~~~~~
execute-return-rc=2
121:4: error: Builtin `fc`: Unknown flag '-v'.
   121 |  fc -v
       |     ^~
note: Use `--` before an operand that begins with a dash.
