[CompoundList]
  [CompoundListCondition, None]
    [Assign d=$TEST_TEMP_DIRECTORY/fc]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$d"]
  [CompoundListCondition, None]
    [SimpleCommand "export" "KOSH_HISTORY=$d/history"]
  [CompoundListCondition, None]
    [FunctionDefinition "seed_fc_history"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "history" "-c"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "echo alpha\necho old-old\nfalse\n"]
          [CompoundListCondition, None]
            [SimpleCommand "history" "-r" "$d/seed"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== list ranges and order =="]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "-3" "-1"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-lrn" "-3" "-1"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "1" "2"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "3" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "3" "1"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-lrn" "3" "1"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "--" "-1"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== execute and substitute =="]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s" "old=new" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s" "old=middle" "middle=new" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-e" "-" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s" "false"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "rc=$?"]
  [CompoundListCondition, None]
    [FunctionDefinition "write_explicit_fc"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "edited_value=explicit\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "write_fcedit_fc"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "edited_value=fcedit\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "write_editor_fc"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "edited_value=editor\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "vi"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "edited_value=vi\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "ed"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "edited_value=ed\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "fail_fc_editor"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "return" "7"]
  [CompoundListCondition, None]
    [FunctionDefinition "write_return_fc"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "return 7\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "write_history_fc"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "history -c\necho after-clear\nhistory\n"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== editor selection and current shell =="]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [Assign FCEDIT=write_fcedit_fc]
  [CompoundListCondition, None]
    [Assign EDITOR=write_editor_fc]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-e" "write_explicit_fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$edited_value"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$edited_value"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "unset" "FCEDIT"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$edited_value"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "unset" "EDITOR"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$edited_value"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--mood" "bash-posix"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$edited_value"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--mood" "kosh"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-e" "fail_fc_editor" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "editor-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-e" "write_return_fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "edit-return-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-e" "write_history_fc" "echo"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== multiline history =="]
  [CompoundListCondition, None]
    [SimpleCommand "history" "-c"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "%s\n" "echo first\necho second"]
  [CompoundListCondition, None]
    [SimpleCommand "history" "-r" "$d/seed"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln" "-1"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "== selection errors =="]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s" "missing-prefix"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "missing-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s" "-0"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "zero-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "seed_fc_history"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "return 7\n"]
  [CompoundListCondition, None]
    [SimpleCommand "history" "-c"]
  [CompoundListCondition, None]
    [SimpleCommand "history" "-r" "$d/seed"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "execute-return-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-v"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "invalid-option-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "history" "-c"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-ln"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "empty-list-rc=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "fc" "-s"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "empty-execute-rc=$?"]
