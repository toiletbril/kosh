[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "alpha:one\nbeta:two\ngamma:three\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\tb\n123456789\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "one\ntwo\nthree\nfour\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cut" "-d" ":" "-f" "2" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cut" "-b" "1-3,6" "records"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a\303\251z\n"]
      [SimpleCommand "koshkit" "cut" "-c" "2"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "abcdef\n"]
      [SimpleCommand "koshkit" "cut" "-b" "1-2 4"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a\303\251z\n"]
      [SimpleCommand "koshkit" "cut" "-b" "3" "-n"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a\303\251z\n"]
      [SimpleCommand "koshkit" "cut" "-b" "1-2" "-n"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a\303\251z\n"]
      [SimpleCommand "koshkit" "cut" "-b" "3-" "-n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "expand" "-t" "4" "spaced"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "koshkit" "unexpand" "-a" "-t" "4" "spaced"]
      [SimpleCommand "koshkit" "expand" "-t" "4"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "fold" "-w" "4" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "fold" "-s" "-w" "6"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "nl" "-ba" "-v" "3" "-i" "2" "-w" "2" "-s" ": " "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "paste" "-d" "," "records" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "paste" "-s" "-d" "," "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "s/:/=/; 2d" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "-n" "2p" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "-n" "2,3p" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "-e" "1i\zero" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "-e" "2a\after" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "-e" "2,3c\replaced" "records"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "sed" "y/ot/OT/" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "split" "-l" "2" "lines" "part"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "cat" "partaa" "partab"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "lines" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "xx00" "xx01"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "a\nmark\nb\nmark\nc\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "piece" "repeated" "/mark/" "{1}"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "piece00" "piece01" "piece02"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "csplit" "-s" "-f" "offset" "repeated" "/mark/+1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "wc" "-c" "offset00" "offset01"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [Subshell]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "koshkit" "csplit" "-s" "-f" "rejected" "repeated" "3" "99"]
  [CompoundListCondition, None]
    [SimpleCommand "test" "!" "-e" "rejected00"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "csplit-cleanup=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pr" "-t" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pr" "-t" "-w" "20" "-s" ":" "-2" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pr" "-t" "-a" "-w" "20" "-s" ":" "-2" "lines"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "left-one\nleft-two\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "right-one\nright-two\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "pr" "-t" "-m" "-w" "30" "-s" ":" "left" "right"]
[Word
  Unquoted "root="
  CommandSubstitution "mktemp -d"
