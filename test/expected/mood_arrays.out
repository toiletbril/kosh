[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$a[@]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$a[*]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$#a[@]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$a[2]"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$#a[@] $a[-1]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$a[@]:1:2"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$a[*]: -2"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$!a[@]"]
  [CompoundListCondition, None]
    [Assign a[10]=far]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$!a[@]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$#a[@]"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "empty $#b[@]"]
  [CompoundListCondition, None]
    [ForLoop "x"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "elem $x"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "n=$#e[@] all=$e[@]"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "appended=$e[2]"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "empty_n=$#g[@]"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "seq=$pvars $specs[1]"]
  [CompoundListCondition, None]
    [FunctionDefinition "f"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "local"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "local_arr=$a[1]"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "empty default, set: [$a[@]:-]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "default, set: [$a[@]:-fallback]"]
  [CompoundListCondition, None]
    [SimpleCommand "unset" "b"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "default, unset: [$b[@]:-fallback]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "alternate, set: [$a[@]:+present]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "star empty default: [$a[*]:-z]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "slice still works: [$a[@]:1:1]"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "no-colon dash, set: [$a[@]-nc]"]
  [CompoundListCondition, None]
    [ForLoop "c"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "loop c=$c"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "declare" "-p" "a"]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand]
  [CompoundListCondition, None]
    [SimpleCommand "declare" "-p" "b"]
