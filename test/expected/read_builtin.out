[CompoundList]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "a b c\n"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "read" "first" "rest"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "first=$first rest=$rest"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "1 2 3\n"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "read" "-a" "arr"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "n=$#arr[@] a0=$arr[0] a2=$arr[2]"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "noeol"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "read" "v"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "rc=$? v=$v"]
  [CompoundListCondition, None]
    [Assign file=$TEST_TEMP_DIRECTORY/read-eof]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "abc"]
  [CompoundListCondition, None]
    [SimpleCommand "read" "x"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "no_newline=[$x] $?"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "def\n"]
  [CompoundListCondition, None]
    [SimpleCommand "read" "y"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "with_newline=[$y] $?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "unlink" "$file"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "x::y\n"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [Assign IFS=:]
          [CompoundListCondition, None]
            [SimpleCommand "read" "a" "b" "c"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "[$a][$b][$c]"]
  [CompoundListCondition, None]
    [SimpleCommand "read" "a" "b" "c" "d"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "[$a][$b][$c][$d]"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "p q r\n"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "read" "m" "n" "o"]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "[$m][$n][$o]"]
