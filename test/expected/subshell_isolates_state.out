[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "$TEST_TEMP_DIRECTORY/subshell-state"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "inside"]
        [CompoundListCondition, None]
          [SimpleCommand "cd" "$TEST_TEMP_DIRECTORY/subshell-state"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "outside"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "alias" "sub_only=echo hi"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [Pipeline]
            [SimpleCommand "alias"]
            [SimpleCommand "koshkit" "grep" "^alias sub_only="]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "leaked from subshell"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "isolated from subshell"]
  [CompoundListCondition, None]
    [Assign cs=$( alias cs_only='echo hi'; echo defined-inside )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "cmdsub reported: $cs"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [Pipeline]
            [SimpleCommand "alias"]
            [SimpleCommand "koshkit" "grep" "^alias cs_only="]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "leaked from cmdsub"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "isolated from cmdsub"]
  [CompoundListCondition, None]
    [SimpleCommand "export" "V=parent"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [Assign V=child]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "1:$V"]
  [CompoundListCondition, None]
    [Assign r=$(V=sub; echo x)]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "2:$V $r"]
  [CompoundListCondition, None]
    [SimpleCommand "export" "W=keep"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "unset" "W"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "3:[$W]"]
  [CompoundListCondition, None]
    [FunctionDefinition "f"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "parent"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [FunctionDefinition "f"]
            [BraceGroup]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "echo" "child"]
        [CompoundListCondition, None]
          [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand "f"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "+e"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "set" "-e"]
        [CompoundListCondition, None]
          [SimpleCommand "false"]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "never-printed"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "e-isolated-parent-survives"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "+f"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "set" "-f"]
  [CompoundListCondition, None]
    [CaseClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "f-LEAKED"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "f-isolated"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "-f"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "set" "+f"]
  [CompoundListCondition, None]
    [CaseClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "f-still-set"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "f-UNSET-LEAK"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "+f"]
  [CompoundListCondition, None]
    [SimpleCommand "trap" "echo PARENT" "EXIT"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "trap" "echo SUB" "EXIT"]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "in-sub"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after-sub"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "plain-sub"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "after-plain"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "exit" "3"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "exit-rc=$?"]
  [CompoundListCondition, None]
    [Assign v=$( trap "echo CSUB" EXIT; echo captured )]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "got=$v"]
  [CompoundListCondition, None]
    [SimpleCommand "set" "--" "-ab"]
  [CompoundListCondition, None]
    [Assign OPTIND=1]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "getopts" "ab" "child_option"]
  [CompoundListCondition, None]
    [SimpleCommand "getopts" "ab" "parent_option"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "getopts-parent=$parent_option:$OPTIND"]
  [CompoundListCondition, None]
    [SimpleCommand "complete" "-W" "parent" "completion-command"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "complete" "-W" "child" "completion-command"]
  [CompoundListCondition, None]
    [SimpleCommand "complete" "-p" "completion-command"]
  [CompoundListCondition, None]
    [Assign completion_output=$(complete -W substitution completion-command)]
  [CompoundListCondition, None]
    [SimpleCommand "complete" "-p" "completion-command"]
  [CompoundListCondition, None]
    [Assign release=$TEST_TEMP_DIRECTORY/subshell-state/release-$BASHPID]
  [CompoundListCondition, None]
    [WhileLoop]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "[" "!" "-e" "$release" "]"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "koshkit" "sleep" "0.01"]
  [CompoundListCondition, None]
    [Assign parent_background=$!]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [WhileLoop]
            [CompoundList]
              [CompoundListCondition, None]
                [SimpleCommand "[" "!" "-e" "$release" "]"]
            [CompoundList]
              [CompoundListCondition, None]
                [SimpleCommand "koshkit" "sleep" "0.01"]
        [CompoundListCondition, None]
          [SimpleCommand ":"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "[" "$!" "=" "$parent_background" "]"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "background-pid-restored"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "background-pid-leaked"]
  [CompoundListCondition, None]
    [IfClause]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "[" "$(jobs -p | koshkit wc -l)" "-eq" "1" "]"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "jobs-restored"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "echo" "jobs-leaked"]
  [CompoundListCondition, None]
    [RedirectedCommand]
      [SimpleCommand ":"]
  [CompoundListCondition, None]
    [SimpleCommand "wait" "$parent_background"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "done"]
