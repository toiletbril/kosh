[CompoundList]
  [CompoundListCondition, None]
    [Assign root=$(mktemp -d)]
  [CompoundListCondition, None]
    [SimpleCommand "cd" "$root"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "mkdir" "-p" "man1"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "LOCAL MANPAGE\n"]
  [CompoundListCondition, None]
    [SimpleCommand "export" "MANPATH=."]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "man" "topic"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "man" "-k" "LOCAL"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "one\ntwo\n"]
      [SimpleCommand "koshkit" "more"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "printf" "one\ntwo\nthree\n"]
      [SimpleCommand "koshkit" "more" "-p" "/two"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "tagged-one\ntagged-two\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "topic\tpaged.txt\t2\n"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "more" "-t" "topic"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "tabs" "-8"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tabs=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "tabs" "4,8,12"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tabs-list=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "tabs" "-a"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tabs-template=$?"]
  [CompoundListCondition, None]
    [Pipeline]
      [SimpleCommand "koshkit" "tput" "clear"]
      [SimpleCommand "koshkit" "od" "-A" "n" "-t" "x1"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "tput" "-T" "xterm" "clear"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "tput-type=$?"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "tput" "longname"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "stty" "-a"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "stty-notty=$?"]
