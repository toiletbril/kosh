[CompoundList]
  [CompoundListCondition, None]
    [FunctionDefinition "greet"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "echo" "hi"]
  [CompoundListCondition, None]
    [SimpleCommand "greet"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "== active body ==\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "lifetime_fn"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "old-start\n"]
          [CompoundListCondition, None]
            [FunctionDefinition "lifetime_fn"]
              [BraceGroup]
                [CompoundList]
                  [CompoundListCondition, None]
                    [SimpleCommand "printf" "new-body\n"]
          [CompoundListCondition, None]
            [SimpleCommand "lifetime_fn"]
          [CompoundListCondition, None]
            [SimpleCommand "unset" "-f" "lifetime_fn"]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "old-end=%s:%s:%s\n" "$FUNCNAME[0]" "$BASH_SOURCE[0]" "$BASH_LINENO[0]"]
  [CompoundListCondition, None]
    [SimpleCommand "lifetime_fn"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "== snapshot body ==\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "snapshot_fn"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "printf" "parent-body\n"]
  [CompoundListCondition, None]
    [Subshell]
      [CompoundList]
        [CompoundListCondition, None]
          [FunctionDefinition "snapshot_fn"]
            [BraceGroup]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "child-body\n"]
        [CompoundListCondition, None]
          [SimpleCommand "snapshot_fn"]
  [CompoundListCondition, None]
    [SimpleCommand "snapshot_fn"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "== substitution body ==\n"]
  [CompoundListCondition, None]
    [Assign substitution_output=$(substitution_fn() { printf 'substitution-body\n'; }; substitution_fn)]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "substitution=%s" "$substitution_output"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "\n"]
  [CompoundListCondition, None]
    [SimpleCommand "printf" "== nested definitions ==\n"]
  [CompoundListCondition, None]
    [FunctionDefinition "outer_fn"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [FunctionDefinition "nested_fn"]
              [BraceGroup]
                [CompoundList]
                  [CompoundListCondition, None]
                    [SimpleCommand "printf" "nested-old\n"]
                  [CompoundListCondition, None]
                    [FunctionDefinition "nested_fn"]
                      [BraceGroup]
                        [CompoundList]
                          [CompoundListCondition, None]
                            [SimpleCommand "printf" "nested-new\n"]
                  [CompoundListCondition, None]
                    [SimpleCommand "nested_fn"]
                  [CompoundListCondition, None]
                    [SimpleCommand "printf" "nested-old-end\n"]
          [CompoundListCondition, None]
            [SimpleCommand "nested_fn"]
  [CompoundListCondition, None]
    [SimpleCommand "outer_fn"]
