[CompoundList]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.25 + 2.5))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((.5 + .25))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((-.125 * 8))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.20 + 2.3))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.5 * 2.00))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((5 / 2.0))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.0 / 3))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((5.5 % 2))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((-4.0 % 2.0))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.20 - 1.20))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((0.0 * -2.00))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((0.00 ** 3))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((1.5 ** 2))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((123456789012345678901234567890.123 + 0.877))"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$((999999999999999999999999999999.9 > 2.0))"]
  [CompoundListCondition, None]
    [Assign decimal_value=1.25]
  [CompoundListCondition, None]
    [ArithmeticCommand "decimal_value += 2.50"]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "$decimal_value"]
  [CompoundListCondition, None]
    [SimpleCommand "koshkit" "calc" "999999999999999999999999999999.9 * 10.0"]
  [CompoundListCondition, None]
    [Assign decimal_formula=999999999999999999999999999999.9]
  [CompoundListCondition, None]
    [FunctionDefinition "decimal_step"]
      [BraceGroup]
        [CompoundList]
          [CompoundListCondition, None]
            [SimpleCommand "local" "decimal_result"]
          [CompoundListCondition, None]
            [Assign decimal_result=$((decimal_formula + decimal_iteration + 0.1))]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [ArithmeticCommand "decimal_result != decimal_formula + decimal_iteration + 0.1"]
              [CompoundList]
                [CompoundListCondition, None]
                  [Assign decimal_lifetime=bad]
          [CompoundListCondition, None]
            [IfClause]
              [CompoundList]
                [CompoundListCondition, None]
                  [ArithmeticCommand "decimal_iteration == 255"]
              [CompoundList]
                [CompoundListCondition, None]
                  [SimpleCommand "printf" "decimal=%s:%s\n" "$#decimal_result" "$decimal_result: -20"]
  [CompoundListCondition, None]
    [Assign decimal_iteration=0]
  [CompoundListCondition, None]
    [Assign decimal_lifetime=ok]
  [CompoundListCondition, None]
    [WhileLoop]
      [CompoundList]
        [CompoundListCondition, None]
          [ArithmeticCommand "decimal_iteration < 256"]
      [CompoundList]
        [CompoundListCondition, None]
          [SimpleCommand "decimal_step"]
        [CompoundListCondition, None]
          [Assign decimal_iteration=$((decimal_iteration + 1))]
  [CompoundListCondition, None]
    [SimpleCommand "echo" "decimal_lifetime=$decimal_lifetime"]
