#!/bin/env kosh
# Indexed array literals are a dash-rejected pure addition, so they run in the
# default strict mood, not only bash mode.
a=(one two three four five)
echo "${a[@]}"
echo "${a[*]}"
echo "${#a[@]}"
echo "${a[2]}"
a+=(six)
echo "${#a[@]} ${a[-1]}"
echo "${a[@]:1:2}"
echo "${a[*]: -2}"
echo "${!a[@]}"
a[10]=far
echo "${!a[@]}"
echo "${#a[@]}"
b=()
echo "empty ${#b[@]}"
for x in "${a[@]:0:3}"; do echo "elem $x"; done


# The bash array literal works in the default mood the way the subscript and
# declare forms already do, including the empty, the append, and the prefix
# sequence forms.
e=(a b)
echo "n=${#e[@]} all=${e[@]}"
e+=(c)
echo "appended=${e[2]}"
g=()
echo "empty_n=${#g[@]}"
flags= pvars=(p) specs=(s1 s2)
echo "seq=$pvars ${specs[1]}"
f() { local a=(1 2); echo "local_arr=${a[1]}"; }
f

# The ${name[@]:-word} test modifiers on a whole array were misread as a
# ${name[@]:offset} substring, so the operator after the colon was fed to the
# arithmetic evaluator. An empty default such as ${a[@]:-} errored with
# "unexpected character" and an unset array dropped its default. The colon before
# a - + = or ? now opens the modifier form, while a real slice still works.
a=(x y)
echo "empty default, set: [${a[@]:-}]"
echo "default, set: [${a[@]:-fallback}]"
unset b
echo "default, unset: [${b[@]:-fallback}]"
echo "alternate, set: [${a[@]:+present}]"
echo "star empty default: [${a[*]:-z}]"
echo "slice still works: [${a[@]:1:1}]"
echo "no-colon dash, set: [${a[@]-nc}]"
for c in "${a[@]:-}"; do echo "loop c=$c"; done

a=(1 2 3)
a+=([-1]=9)
declare -p a
b=(10 20 30 40)
b+=([-2]=99)
declare -p b
