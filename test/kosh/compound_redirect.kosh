#!/bin/env kosh
koshkit mkdir -p "$TEST_TEMP_DIRECTORY"
redirect_file=$TEST_TEMP_DIRECTORY/compound-redirect
(echo hi) > "$redirect_file"
cat "$redirect_file"
echo back
{ echo a; echo b; } > "$redirect_file"
wc -l < "$redirect_file" | tr -d ' '
for n in 1 2 3; do echo $n; done > "$redirect_file"
cat "$redirect_file"
if true; then echo y; fi 2>/dev/null
koshkit unlink "$redirect_file"
