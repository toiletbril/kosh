#!/bin/env kosh
echo "== DEBUG =="
trap 'echo D' DEBUG
echo one
echo two
trap - DEBUG
echo "== ERR =="
trap 'echo E' ERR
false
true
trap - ERR
echo "== RETURN =="
f() { echo body; return 7; }
trap 'echo R' RETURN
f
echo "rc=$?"
trap - RETURN
echo "== GUARDED LOOP =="
set --mood bash
trap 'echo unexpected' ERR
for item in one two; do
  false && echo unreachable
done
echo "rc=$?"
trap - ERR
