#!/bin/sh
# The sh shebang arms the bashism gate, so the analysis warns on each bash-only
# construct. The triggers sit in a function that is never called, so nothing
# runs.
lint_only() {
  echo -e escaped
  echo -n nonewline
  declare -A assoc
  typeset scoped
  source library.sh
}
word_only() {
  cat <(echo substituted)
  echo !(excluded)
  echo $'a\tb'
  echo [^a]tail
  echo "$(<file)"
  echo "`<file`"
  echo "${!indirect}"
  echo "${array[0]}"
  echo "${!array[@]}"
  echo "${!prefix*}"
  echo "${text:1:2}"
  echo "${text/from/to}"
  echo "$RANDOM"
  echo "${text:-default}"
  echo "${#text}"
}
redirect_only() {
  echo both &>out.log
  echo append &>>out.log
  echo dup >&outfile
  exec {logfd}>trace.log
  echo high 12>high.log
  echo net >/dev/tcp/example.com/80
  echo glob >prefix*.log
  echo plain >plain.log 2>&1
}
operator_only() {
  ((counter + 1))
  : $((counter++))
  : $((counter--))
  : $((base ** exponent))
  [ alpha \< beta ]
  [ alpha \> beta ]
  [ first -nt second ]
  [ first -ef second ]
  [ -a present ]
  [ alpha = beta ]
  [ -e present ]
}
timed_only() {
  time printf 'timed\n' | wc -l
  time { printf 'grouped\n'; }
  time ( printf 'subshell\n' )
  time printf 'plain\n'
}
command_only() {
  LIST+=extra
  PREFIX+=extra env
  exec -c env
  let value=1
  trap 'cleanup' ERR
  trap 'cleanup' SIGINT
  trap 'cleanup' int
  trap 'cleanup' INT
  trap 'cleanup' EXIT
  printf '%q\n' "$value"
  printf '%s\n' "$value"
  . library.sh extra
  . library.sh
}
positional_zero_assignment() {
  $0=zero
}
array_and_scope_only() {
  mapfile -t lines < roster
  readarray -t rows < roster
  printf -v buffer '%s' text
  local scoped=value
}
compound_redirect_only() {
  { echo grouped; } &>both.log
  { echo globbed; } >prefix*.log
}
echo done
