#!/bin/sh
# The sh shebang arms the bashism gate, so the analysis warns on each bash-only
# construct. The triggers sit in a function that is never called, so nothing
# runs.
lint_only() {
  echo -e escaped
  echo -n nonewline
  declare -A assoc
  typeset scoped
  source library.sh
}
word_only() {
  cat <(echo substituted)
  echo !(excluded)
  echo $'a\tb'
  echo [^a]tail
  echo "$(<file)"
  echo "`<file`"
  echo "${!indirect}"
  echo "${array[0]}"
  echo "${!array[@]}"
  echo "${!prefix*}"
  echo "${text:1:2}"
  echo "${text/from/to}"
  echo "$RANDOM"
  echo "${text:-default}"
  echo "${#text}"
}
redirect_only() {
  echo both &>out.log
  echo append &>>out.log
  echo dup >&outfile
  exec {logfd}>trace.log
  echo high 12>high.log
  echo net >/dev/tcp/example.com/80
  echo glob >prefix*.log
  echo plain >plain.log 2>&1
}
echo done
