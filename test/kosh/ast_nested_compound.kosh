#!/bin/env kosh
if true; then ( while false; do echo x; done; { echo y; } ); fi >/dev/null


true && echo a || echo b && false || true

{ echo a; echo b; }

case word in a|b|word) echo m;; *) echo d;; esac

[[ -n x && abc == a* ]] && echo yes

function f { echo f; }
g() { echo g; }
f; g

cat <<EOF >/dev/null
line one
line two
EOF

echo hi | cat | cat >/dev/null

{ echo a; } >/dev/null

( echo a; echo b )
