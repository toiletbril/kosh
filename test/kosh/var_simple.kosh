#!/bin/env kosh
FOO=bar
echo $FOO
echo ${FOO}
echo "$FOO and more"


x=a; x+=bc; echo "$x"; n+=z; echo "$n"
newline_assignment=one
background_assignment=two &
true && and_assignment=three
false || or_assignment=four
echo separators-ok

# A lone assignment expands its value before it resets the status, so a $? in
# the value reads the prior command's status the way bash does. The assignment
# itself then reports zero, while a command substitution in the value reports
# the substitution's status.
false; x=$?; echo "after_false=$x"
true; x=$?; echo "after_true=$x"
(exit 7); x=$?; echo "after_exit7=$x"
false; x=$?; echo "status_after_assign=$?"
false; y=a$?z; echo "embedded=$y"
x=$(false); echo "csub_status=$?"
false; x=$(true); echo "csub_resets=$?"
a[0]=$(false); echo "array_csub_status=$?"
x=A; false; x+=$?; echo "append=$x"

export FOO=bar
echo "$FOO"
BAZ=qux
export BAZ
echo "$BAZ"

export FOO=1
FOO=2
printenv FOO
export BAR
BAR=baz
printenv BAR
NOPE=hidden
printenv NOPE
echo done

w=1 b=$w c=$b; echo "[$w][$b][$c]"
x=foo x+=bar; echo "[$x]"
y=1 y=2; echo "[$y]"

# shellcheck disable=SC2125
Y=data/*
echo $Y
echo "$Y"

false
echo $?
true && echo $?

X="a  b   c"
echo $X
echo "$X"

set +u
echo $NOPE end
echo "$NOPE" end
echo a${NOPE}b
