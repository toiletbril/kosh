#!/bin/env kosh
set -- a b c
echo "$@"
echo "$#"
IFS=:; echo "$*"
echo "${999:-fallback}"
x=hello; echo "${x#he}" "${x%lo}" "${#x}" "${x:1:3}"
echo "${nope:-def}" "${x:+yes}"
echo "marker$!end"


# Bash parameter expansion forms run in the default mood.
word="configure-script-runner"
echo "${word%%-*}"
echo "${word##*-}"
echo "${word//-/_}"
echo "${word/-/_}"
echo "${word/#configure/setup}"
echo "${word/%runner/walker}"
echo "${word^^}"
upper=${word^^}
echo "${upper,,}"
echo "${word~}"
echo "${word:10:6}"
echo "${word: -6}"
echo "${#word}"
ref=word
echo "${!ref}"
prefix_one=1
prefix_two=2
echo "${!prefix_*}"
echo "${undef:-fallback}" "${word:+present}"

v=hello; u=WORLD; echo "${v^}|${v^^}|${u,}|${u,,}|${v^^l}"

v=hello
echo "${v:0:-2}"
echo "${v: -3:2}"
echo "${v:(-3)}"
echo "${v:10}"
echo "${v//l/L}"
w=a.b.c
echo "${w%.*}"
echo "${w##*.}"

a=b; b=hi; foo1=1; foo2=2; echo "${!a}"; echo ${!foo*}

v=hello; echo "${v//l/L}|${v/#he/HE}|${v/0/X}|${v//[lo]/_}"

v=abcdefgh; echo "${v:2:3}|${v: -3}|${v:2:-1}|${v:20}"

x=; y=; echo "${x:-${y:-N}}"
HOME=/h; echo "${HOME:+${HOME}/bin}"
a=1; echo "${z:-${a}${a}}"

x='a*c'; printf "%s\n" "${x%"*c"}"
x=abc; p='*'; printf "%s\n" "${x##"$p"}"
x="a*c"; printf "[%s]\n" "${x#a\*}"
x=aXc; printf "[%s]\n" "${x#a\X}"
x="abc"; printf "[%s]\n" "${x#a*}"
v='a*b*c'; printf "[%s]\n" "${v%%"*"*}"
