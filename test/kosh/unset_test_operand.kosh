#!/bin/env kosh
echo "== [ -z unset ]:"
[ -z "$UNSET_VAR" ]; echo "exit=$?"
echo "== [ -n unset ]:"
[ -n "$UNSET_VAR" ]; echo "exit=$?"
echo "== [[ -z unset ]]:"
[[ -z "$UNSET_VAR" ]]; echo "exit=$?"
echo "== [[ unset -ne 0 ]]:"
[[ "$UNSET_VAR" -ne 0 ]]; echo "exit=$?"
echo "== [ unset -ne 0 ] (builtin, integer expected):"
( [ "$UNSET_VAR" -ne 0 ] ) 2>&1; echo "exit=$?"
echo "== set -u aborts a bare reference:"
( set -u; echo "$UNSET_VAR" ) 2>&1
echo "rc=$?"
