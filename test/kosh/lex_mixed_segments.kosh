#!/bin/env kosh
# The names below stand in for word segments and are never assigned on purpose.
# shellcheck disable=SC2154
: pre"dq"'sq'$x${y}post
: "a$b"'c'$(:)"d$(( 1 + 1 ))e"


: $(( 1 + 2 ))
: pre$(( 3 * 4 ))post
: "val=$(( 5 - 1 ))end"
: $(( 6 ))$(( 7 ))

: "$(:)"
: pre$(:)post
: "head$(:)tail"
: $(:)$(:)

: a\*b c\?d
: \$foo \~home
: \" \\ \`
: pre\ space

set -f
: a*b c?d [a-z]
: "lit*" 'lit?' "[abc]"

: bare 'single' "double"
: pre'mid'post
: out"in"out
: 'one''two'"three"

: ~ ~user ~/path
: pre~mid "~quoted" '~raw'
