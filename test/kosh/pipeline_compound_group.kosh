#!/bin/env kosh
# shellcheck disable=SC2251
echo x | { cat; }
seq 1 3 | { read a; read b; echo "$a-$b"; }


echo 1 | cat | cat | cat;
echo 2 | cat && echo 3 | cat;
echo 4 | false || echo 4;
{ echo a; } | cat

(echo hi) | cat
(echo a; echo b) | wc -l | tr -d ' '

printf 'a\nb\nc\n' | while read l; do echo "got $l"; done

true | false
echo "tf=$?"
false | true
echo "ft=$?"
false | read -r x
echo "fr=$?"
echo hi | read -r y
echo "er=$?"
true | true
echo "tt=$?"
! true | false
echo "neg=$?"
