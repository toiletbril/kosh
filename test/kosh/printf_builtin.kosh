#!/bin/env kosh
printf "tab\tnl\nff\fvt\v\n"
printf "%b\n" "\012x"
printf "%b\n" "lit\\\\"
printf "[%c]\n" ""
printf "100%%\n"
printf "%Q\n" hi
printf "%d\n" +5
printf "%.3s\n" abcdef
printf "end%"
echo


# printf with the bash q and b conversions and width in the default mood.
printf '%q\n' 'a b'
printf '%q\n' 'a$b;c'
printf '%q\n' ''
printf '%b\n' 'x\ty\n'
printf '[%d]' 1 2 3; echo
printf '%5d|%-5d|%05d\n' 42 42 42
printf '%X %o %c\n' 255 8 65
printf -v captured '%04d' 7
echo "captured=${captured-}"

printf "%.2f\n" 3.5
printf "%b\n" "a\tb\n"
printf "%*d\n" 4 7
printf "[%*.*f]\n" 8 2 3.5
printf "%b" "stop\chere"
echo

printf '%d\n' "'A"
printf '%x\n' "'A"
printf '%o\n' "'A"
printf '%u\n' "'A"
printf '%d\n' '"A'
printf '%d\n' "'AB"

printf '%d %d %x %o\n' 42 010 0x1f 8

printf '%300d\n' 5
printf '%.290f\n' 1

printf '%d\n' 99999999999999999999999999
echo "rc=$?"
printf '%d\n' -99999999999999999999
echo "rc=$?"
printf '%x\n' 0xffffffffffffffffffff
echo "rc=$?"
printf '%d\n' 42
echo "rc=$?"
