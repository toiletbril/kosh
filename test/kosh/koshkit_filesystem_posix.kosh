#!/bin/env kosh
#
#    This file is a part of the Koshka shell, (c) toiletbril, 2026
#    See the top-level LICENSE file for the licensing information.
#
# This script verifies POSIX permission, ownership, symbolic-link, and FIFO
# behavior in bundled filesystem utilities.

root=$(mktemp -d)
koshkit mkdir -p "$root/tree/child"
: > "$root/mode"
: > "$root/tree/plain"

koshkit chmod 640 "$root/mode"
mode_fields=$(koshkit ls -l "$root/mode")
echo "chmod-octal=${mode_fields%% *}"
koshkit chmod u+x,g=u,o-r "$root/mode"
mode_fields=$(koshkit ls -l "$root/mode")
echo "chmod-symbolic=${mode_fields%% *}"
koshkit chmod -R a+rX "$root/tree"
[[ -x "$root/tree/child" ]]
directory_status=$?
plain_fields=$(koshkit ls -l "$root/tree/plain")
echo "chmod-recursive=$directory_status ${plain_fields%% *}"
: > "$root/omitted-who"
koshkit chmod 444 "$root/omitted-who"
koshkit chmod +w "$root/omitted-who"
omitted_fields=$(koshkit ls -l "$root/omitted-who")
echo "chmod-umask=${omitted_fields%% *}"

uid=$UID
gid=${GROUPS[0]}
koshkit chown "$uid:$gid" "$root/mode"
echo "chown=$?"
owner_name=$(koshkit whoami)
koshkit chown "$owner_name:$gid" "$root/mode"
echo "chown-name=$?"
koshkit chgrp "$gid" "$root/mode"
echo "chgrp=$?"

koshkit ln -s "$root/mode" "$root/ln-symbolic"
[[ -L "$root/ln-symbolic" ]]
echo "ln-symbolic=$?"

koshkit mkfifo -m 600 "$root/fifo"
fifo_fields=$(koshkit ls -l "$root/fifo")
echo "mkfifo=${fifo_fields%% *}"
koshkit mkfifo "$root/fifo" 2> "$TEST_NULL_DEVICE"
echo "mkfifo-existing=$?"
koshkit mkfifo -m a-w "$root/read-only-fifo"
fifo_fields=$(koshkit ls -l "$root/read-only-fifo")
echo "mkfifo-symbolic=${fifo_fields%% *}"

if [[ -n "$root" ]]; then
  "$TEST_SYSTEM_RM" -rf -- "$root"
fi
