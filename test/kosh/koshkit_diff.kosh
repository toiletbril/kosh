root=$(mktemp -d)
cd "$root"

printf 'one\ntwo\nthree\nfour\nfive\n' > left
printf 'one\nTWO\nthree\nfour\nfive\n' > right

koshkit diff left left
echo "equal=$?"
koshkit diff -u --label left --label right left right
echo "unified=$?"
koshkit diff left right
echo "normal=$?"

printf 'a  b\r\n' > left
printf 'a b\n' > right
koshkit diff -w left right
echo "whitespace=$?"

printf 'left' > left
printf 'right' > right
koshkit diff -u -L left -L right left right
echo "missing-newline=$?"

: > left
printf 'added\n' > right
koshkit diff -u -L left -L right left right
echo "insertion=$?"
koshkit diff -u -L right -L left right left
echo "deletion=$?"

printf 'a\0b\n' > left
printf 'a\0c\n' > right
koshkit diff left right
echo "binary=$?"
koshkit diff -a -u -L left -L right left right | koshkit wc -c
echo "text=$?"

printf 'same\n' > right
printf 'same\n' | koshkit diff - right
echo "stdin=$?"
set +o pipefail
printf 'same\n' | koshkit diff - -
echo "double-stdin=$?"
set -o pipefail

printf 'a\na\n' > left
printf 'b\na\n' > right
koshkit diff -u -L left -L right left right
echo "repeated=$?"

printf 'one\nthree\n' > left
printf 'one\ntwo\nthree\n' > right
koshkit diff -u -L left -L right left right
echo "middle-insertion=$?"
koshkit diff -u -L right -L left right left
echo "middle-deletion=$?"

printf 'old-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nold-2\n' > left
printf 'new-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nnew-2\n' > right
koshkit diff -u -L left -L right left right
echo "merged-hunks=$?"

printf 'old-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nkeep-7\nold-2\n' > left
printf 'new-1\nkeep-1\nkeep-2\nkeep-3\nkeep-4\nkeep-5\nkeep-6\nkeep-7\nnew-2\n' > right
koshkit diff -u -L left -L right left right
echo "separate-hunks=$?"

printf 'same' > left
printf 'same' > right
koshkit diff left right
echo "equal-no-newline=$?"

koshkit diff absent right > /dev/null 2>&1
echo "missing=$?"
