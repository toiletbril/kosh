#!/bin/env kosh
echo a $(echo b) c


v=$(echo hello); echo got=$v

result=$(echo hello  # a ) comment
)
echo "$result"
mid=$(echo foo#bar)
echo "$mid"
quoted=$(echo "a # ) b")
echo "$quoted"
nested=$(echo $(echo inner # ) cmt
))
echo "$nested"

x=$( cat <<< "payload" )
echo "x=$x"
empty=""
y=$( cat <<<"$empty" )
echo "y=$y"
z=$( echo "$( echo nested )" -- "$x" )
echo "z=$z"
w=$( echo "$( printf '%s\n' "'")")
echo "w=$w"
line="part value tail"
tar=$( printf '%s\n' "$line" | sed -e 's/^.* \([^ ]*x\) .*$/\1/' <<<"$line" )
echo "tar=$tar"

f(){ echo "$(echo hi)"; }
f
:
f
:
f

echo $(echo $(echo deep))

for w in $(echo x y z); do echo i=$w; done

x=$(false)
echo after_false=$?
y=$(true)
echo after_true=$?

# A command that expands to nothing takes the status of the last command
# substitution it ran, the way bash does, so a bare $(false) or ${ false; }
# reports the failure while a plain assignment line resets to zero.
$(false); echo "bare_csub=$?"
${ false; }; echo "bare_funsub=$?"
true; $(false); echo "vanished_word=$?"
a=$(true) b=$(false); echo "last_assign=$?"
a=$(false) b=$(true); echo "last_assign2=$?"
a=1 b=2; echo "plain_assign=$?"
