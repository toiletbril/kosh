#!/bin/env kosh
lint_only() {
  grep *.txt file
  grep '*x' file
  for f in $(cat list); do echo "$f"; done
  for f in $(find . -name x); do echo "$f"; done
  find . | xargs echo
  true | echo discarded
}
echo done

lint_only() {
  command 2>&1 > out.log
  sort < data > data
  echo "wrapped $(echo inner)"
  printf '%s' "a $@ b"
}
echo done

lint_only() {
  [ -z lit ] && echo a
  [ count -eq notanumber ] && echo b
  [ "$x" = "glob*" ] && echo c
  [ -n "$(ls | grep x)" ] && echo d
}
echo done

case a in a) ;; esac
case a in *) ;; esac

# Triggers in a function that is never called, so the analysis warns while
# nothing runs.
lint_only() {
  egrep pattern file
  fgrep word file
  expr 1 + 2
  let counter=counter+1
  echo "$(date)"
  ps | grep init
  ls | grep conf
  grep needle file | wc -l
  local outside=here
  [ $? -eq 0 ] && echo ok
  local declared=$(date)
}
echo done

f() { x=1; }
g() { local y=2; y=3; }
h() { z=4; }
top=5

a() { local x=1; x=2; echo "$x"; }
b() { declare -A m; m[k]=v; }
c() { local s; s+=tail; }
outer=1

[ ! 1 -eq 2 ]
[ ! a = b ]

set -- 'fmt\n'
printf "$1"
printf '%s' ok
printf -- "$1"

read x < /dev/null
read -r y < /dev/null

[ -f a -a -f b ]
[ ! -z "$x" ]
[ ! -n "$y" ]
false && [ ! -a /nonexistent ]

echo $(echo hi)
export FOO=$(echo hi)
echo "$(echo hi)"

cat data/hello-d | cat

which sh >/dev/null 2>&1

new_diagnostics() {
  for file in $(ls *.mp3); do echo "$file"; done
  for file in "*.mp3"; do echo "$file"; done
  files=($(printf '%s\n' one two))
  find . -name *.ogg
  find . -exec sh -c 'echo {}' \;
  unset values[0]
  read $target
  for argument in $*; do echo "$argument"; done
  echo "$*"
  printf '%s %s\n' one
  command -v sudo >/dev/null 2>&1 && sudo echo protected > output
  exec echo replaced; echo unreachable
  cd missing; echo wrong-directory
  true && false || echo fallback
  echo one | read -r pipeline_value
  echo "$pipeline_value"
  [[ 10 > 7 ]]
  [[ left < right ]]
  [[ value =~ 'v.*' ]]
  [[ -e *.txt ]]
  [[ $left=$right ]]
  [[ -n literal ]]
  echo {1..$limit}
  tr [A-Z] [a-z]
  index=0
  echo redirected > "file$((index++))"
  echo $value
  echo "~"
  echo '$value'
  read -r number
  echo $((number + 1))
  export CDPATH=.:~/project
}

annoying_style_diagnostics() {
  echo one >> style.log
  echo two >> style.log
  echo three >> style.log
  echo `date`
  echo $(($number + 1))
  [ x"$value" = xvalue ]
  PS1='\e[31m> '
}

annoying_safety_diagnostics() {
  find . -exec echo {}
  [ value =~ expression ]
  while read -r host; do command -v ssh >/dev/null 2>&1 && ssh "$host" uptime; done
  alias archive='mv $1 /backup'
  find . -name '*.bak' -o -name '*~' -delete
  echo $10
  $(printf command)
  arguments="$@"
  PATH="$PATH:~/bin"
  echo $[1+2]
  for outer_index in one; do
    for outer_index in two; do echo "$outer_index"; done
  done
  case value in
  same) : ;;
  same) : ;;
  '*') : ;;
  literal-after-star) : ;;
  prefix*) : ;;
  prefix-value) : ;;
  esac
}

test_operator_diagnostics() {
  let "counter -lt limit"
  [[ "$left" >= "$right" ]]
  [ "$left" \>= "$right" ]
  [ "$left" -foo "$right" ]
  [ -foo "$right" ]
  [ "$left" -gt 1.5 ]
  [[ "$left" -eq notanumber ]]
  [ "$left" -gt count+1 ]
  recursive_wrapper == value
  [ -5 -gt 3 ]
  [ --help ]
  [ -verbose = "$left" ]
  [ -e "$left" -a -e "$right" ]
}

constant_test_diagnostics() {
  [ ]
  [ false ]
  [ 0 ]
  [ true ]
  [ 1 ]
  [ literal ]
  [ "$(ls)" ]
  [ "$left" ]
  [ -n ]
  [ a = b ]
  [ "$left" = b ]
  [ "$left" != a -o "$left" != b ]
  [[ $left != a || $left != b ]]
  [ "$left" != a ] || [ "$left" != b ]
  [[ -z == foo ]]
}

test_grouping_diagnostics() {
  [ "$left" = a && "$right" = b ]
  [ "$left" = a || "$right" = b ]
  echo trailing ]
  [[ "$left" = a -a "$right" = b ]]
  [[ "$left" = a -o "$right" = b ]]
  [[ \( "$left" = a \) ]]
  [[ { "$left" = a } ]]
  [ "$left" > "$right" ]
  [ "$left" < "$right" ]
  echo written > 2
  if ( -f "$left" ); then echo found; fi
  if ( [ -f "$left" ] ); then echo found; fi
  if ( [[ -f "$left" ]] ); then echo found; fi
}

test_operand_expansion_diagnostics() {
  [ "$@" = one ]
  [ "${values[@]}" = one ]
  [ {a,b} = one ]
  [ *.txt = one ]
  [ -d *.txt ]
  [ -v arr[i] ]
  [ -n $value ]
  [[ "$@" = one ]]
  [[ {a,b} = one ]]
  [[ *.txt = one ]]
  [[ "$left" = $right ]]
  [[ "$left" != $right ]]
  [[ "$left" =~ *.txt ]]
}

file_command_diagnostics() {
  ls | xargs rm
  ls | wc -l
  find -name '*.txt'
  mv file.txt
  cp -r dir
  ln -s target
  xargs -i echo replaced < list
}

text_utility_diagnostics() {
  echo "$value" | wc -c
  sed 's/old/new/' file
  true | ls
  find . -exec echo $(basename x) \;
  tr a-z A-Z
  tr 'hello' 'world'
  grep 'file*' list
  echo 'line\n'
  [ -n "$(grep needle file)" ]
  printf 'plain\n' one two
}

helper_function() { echo helper; }

privilege_and_builtin_diagnostics() {
  ssh remote "echo $value"
  ssh -p 22 remote "echo $value"
  ssh remote 'echo literal'
  su operator helper_function
  su - -c helper_function
  su operator whoami
  find . -exec helper_function {} \;
  find . -execdir helper_function {} \;
  ls | xargs helper_function
  cd /tmp
  cd -
  break
  set assigned=value
  return one two
  exit one two
  return $(echo 5)
  export $exported_name
  sudo cd /tmp
  sudo export FOO=1
}

trap_condition_diagnostics() {
  trap 'helper_function' 9
  trap 'helper_function' 15
  trap 'helper_function' KILL
  trap 'helper_function' SIGSTOP
  trap 'helper_function' INT
  trap - EXIT
}

assignment_value_diagnostics() {
  local counter=0
  counter=$counter+1
  counter=counter+1
  PATH=/opt/local/bin
  pattern=*.txt
  braces=file{a,b}.txt
}

assignment_pipeline_diagnostics() {
  piped=value | wc -l
  first=one second=two | wc -l
  swallowed=printf 'x\n'
}

array_name_diagnostics() {
  entries=(one two)
  echo "$entries"
  entries=scalar
  entries+=tail
  grid[1][2]=corner
  spread=($loose)
  declare -a declared
  declared=flat
  mapfile -t filled < /etc/hosts
  echo "$filled"
}

quoted_value_diagnostics() {
  options='-t "one two"'
  wc $options
}

command_word_shape_diagnostics() {
  echo "one"two"three"
  : ${SANDWICH:=fallback}
  same=1
  same=$same
  IFS="\t"
  pager=cat
  $1=first
  $0=zero
  prefix$suffix=1
  odd.name==value
  ===
  ===trail
  =lead
  "$quoted"=42
  9lives=cat
  spaced += tail
}

redirection_semantics_diagnostics() {
  > report.txt
  < file.txt | grep foo
  cat file > tr
  gzcat a | grep x < today.log
  env > environment.txt | grep ANDROID
  grep foo < in1 < in2 > out1 > out2
  ssh host <<BARE
echo "$HOSTNAME"
BARE
  ssh host <<"QUOTED"
echo "$HOSTNAME"
QUOTED
}

arithmetic_diagnostics() {
  echo $((a / b * c))
  echo $((a * b / c))
  echo $((1.5 + 2))
  echo $((010 + 1))
  echo $((0x1F + 1))
  $((count + 1))
  (( total / parts * scale ))
}

loop_word_diagnostics() {
  for one_word in single; do echo "$one_word"; done
  for entry in ${directory}/*.txt; do echo "$entry"; done
  while true; do
    echo hi | grep -q bye | break
  done
}

case_shape_diagnostics() {
  case constant in
  constant) : ;;
  *) : ;;
  esac
  case "$prefix suffix" in
  nomatch) : ;;
  *) : ;;
  esac
  case "$value" in
  $expanded) : ;;
  *) : ;;
  esac
  while getopts "ab:" chosen_option; do
    case $chosen_option in
    a) : ;;
    z) : ;;
    esac
  done
}

compound_list_diagnostics() {
  ( echo first || echo second ) && echo third
  ! false
  echo after
}

false && break
false && continue

recursive_wrapper() { recursive_wrapper "$@"; }

directive_scope() {
  # shellcheck disable=SC2086
  echo $suppressed
  echo $reported
}

directive_placement_diagnostics() {
  # shellcheck foobar=baz
  echo one
  # shellcheck disable=SC2153 not a misspelling
  echo two
  echo three # shellcheck disable=SC2034
  if false; then
    echo four
  # shellcheck disable=SC2086
  elif false; then
    echo five
  fi
  case "$1" in
  first) : ;;
  # shellcheck disable=SC2086
  *) : ;;
  esac
}

source_byte_diagnostics() {
  echo “curly”
  echo ‘curly’
  ls –l
  echo "inside ” quotes"
  echo 'inside ’ quotes'
}
source_byte_diagnostics() {
  echo spaced word
  echo 'carriagereturn'
}

escape_style_diagnostics() {
  echo Yay \o/
  spacing=foo\tbar
  echo 'no way it\'
  quoted='long \
text'
  echo "The apples are $""1 each"
  echo "$"
  \ls -l
  sed \
  # -e "middle" \
  -e x file
}

command_name_assignment_diagnostics() {
  runner=printf
  linker=ln
  $linker -s target link
}

html_entity_diagnostics() {
  echo one &amp echo two
}
