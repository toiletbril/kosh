printf 'scale=2; 1/8\n2^10\n' | koshkit bc
echo "bc=$?"

echo bc-core
printf '%s\n' '/* ignored */' 'a=2' 'b=3' 'b' 'a' 'missing' 'a+=5.47' 'a' | koshkit bc
printf '%s\n' '"line string"' 'scale(123.450)' 'length(123.450)' 'sqrt(2)' 'scale=10' 'sqrt(2)' | koshkit bc
echo bc-bases
printf '%s\n' 'ibase=2' '1011.01' 'ibase=A' 'obase=16' '255' | koshkit bc
echo bc-control
printf '%s\n' 'if(1) 2' 'if(0) 3' 'for(i=0;i<3;i++) i' 'i=0' 'while(i<3) ++i' 'while(1) break' 'if(0) quit' '9' | koshkit bc
echo bc-functions
printf '%s\n' 'define add(a,b) { return(a+b) }' 'define local(a) { auto x; x=9; a=7; return(x+a) }' 'g=5' 'add(2,3)' 'local(g)' 'g' 'arr[0]=4' 'arr[1]=6' 'define mutate(a[]) { a[0]; a[0]=8 }' 'mutate(arr[])' 'arr[0]' | koshkit bc
printf '%s\n' 'define x(x,y) { return(x-y+5) }' 'define y(y,x) { return(x(y,x)+x(x,y)) }' 'y(1,4)' | koshkit bc
printf '%s\n' '10^70' | koshkit bc
echo bc-continuation
printf '1\\\n2\n0.\\\n345\n' | koshkit bc
echo bc-math
printf '%s\n' 'scale=12' 's(1)' 'c(1)' 'a(1)' 'l(2)' 'e(1)' | koshkit bc -l

koshkit expr 2 + 3 '*' 4
koshkit expr 7 '>' 3
koshkit expr abc : 'a\(.*\)'
koshkit expr ababa : '\(ab*\)\1a'
koshkit expr 0 '|' hello
koshkit expr 0 >/dev/null
echo "expr-false=$?"
