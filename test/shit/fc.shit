#!/bin/env shit
d=$TEST_TEMP_DIRECTORY/fc
shitbox mkdir -p "$d"
export SHIT_HISTORY=$d/history

seed_fc_history()
{
  history -c
  printf 'echo alpha\necho old-old\nfalse\n' > "$d/seed"
  history -r "$d/seed"
}

seed_fc_history
echo '== list ranges and order =='
fc -ln -3 -1
fc -lrn -3 -1
fc -ln 1 2
fc -ln 3 3
fc -ln 3 1
fc -lrn 3 1
fc -ln -- -1

seed_fc_history
echo '== execute and substitute =='
fc -s old=new echo
echo "rc=$?"
fc -ln
seed_fc_history
fc -s old=middle middle=new echo
echo "rc=$?"
seed_fc_history
fc -e - echo
echo "rc=$?"
seed_fc_history
fc -s false
echo "rc=$?"

write_explicit_fc()
{
  printf 'edited_value=explicit\n' > "$1"
}
write_fcedit_fc()
{
  printf 'edited_value=fcedit\n' > "$1"
}
write_editor_fc()
{
  printf 'edited_value=editor\n' > "$1"
}
vi()
{
  printf 'edited_value=vi\n' > "$1"
}
ed()
{
  printf 'edited_value=ed\n' > "$1"
}
fail_fc_editor()
{
  return 7
}
write_return_fc()
{
  printf 'return 7\n' > "$1"
}
write_history_fc()
{
  printf 'history -c\necho after-clear\nhistory\n' > "$1"
}

echo '== editor selection and current shell =='
seed_fc_history
FCEDIT=write_fcedit_fc
EDITOR=write_editor_fc
fc -e write_explicit_fc echo
echo "$edited_value"
seed_fc_history
fc echo
echo "$edited_value"
seed_fc_history
unset FCEDIT
fc echo
echo "$edited_value"
seed_fc_history
unset EDITOR
fc echo
echo "$edited_value"
seed_fc_history
set --mood bash-posix
fc echo
echo "$edited_value"
set --mood shit
seed_fc_history
fc -e fail_fc_editor echo
echo "editor-rc=$?"
seed_fc_history
fc -e write_return_fc echo
echo "edit-return-rc=$?"
seed_fc_history
fc -e write_history_fc echo

echo '== multiline history =='
history -c
printf '%s\n' 'echo first\necho second' > "$d/seed"
history -r "$d/seed"
fc -ln -1
fc -s

echo '== selection errors =='
seed_fc_history
fc -s missing-prefix
echo "missing-rc=$?"
fc -s -0
echo "zero-rc=$?"
seed_fc_history
printf 'return 7\n' > "$d/seed"
history -c
history -r "$d/seed"
fc -s
echo "execute-return-rc=$?"
fc -v
echo "invalid-option-rc=$?"
history -c
fc -ln
echo "empty-list-rc=$?"
fc -s
echo "empty-execute-rc=$?"
