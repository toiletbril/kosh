#!/bin/env shit
lint_only() {
  grep *.txt file
  grep '*x' file
  for f in $(cat list); do echo "$f"; done
  for f in $(find . -name x); do echo "$f"; done
  find . | xargs echo
  true | echo discarded
}
echo done

lint_only() {
  command 2>&1 > out.log
  sort < data > data
  echo "wrapped $(echo inner)"
  printf '%s' "a $@ b"
}
echo done

lint_only() {
  [ -z lit ] && echo a
  [ count -eq notanumber ] && echo b
  [ "$x" = "glob*" ] && echo c
  [ -n "$(ls | grep x)" ] && echo d
}
echo done

case a in a) ;; esac
case a in *) ;; esac

# Triggers in a function that is never called, so the analysis warns while
# nothing runs.
lint_only() {
  egrep pattern file
  fgrep word file
  expr 1 + 2
  let counter=counter+1
  echo "$(date)"
  ps | grep init
  ls | grep conf
  grep needle file | wc -l
  local outside=here
  [ $? -eq 0 ] && echo ok
  local declared=$(date)
}
echo done

f() { x=1; }
g() { local y=2; y=3; }
h() { z=4; }
top=5

a() { local x=1; x=2; echo "$x"; }
b() { declare -A m; m[k]=v; }
c() { local s; s+=tail; }
outer=1

[ ! 1 -eq 2 ]
[ ! a = b ]

set -- 'fmt\n'
printf "$1"
printf '%s' ok
printf -- "$1"

read x < /dev/null
read -r y < /dev/null

[ -f a -a -f b ]
[ ! -z "$x" ]
[ ! -n "$y" ]
false && [ ! -a /nonexistent ]

echo $(echo hi)
export FOO=$(echo hi)
echo "$(echo hi)"

cat data/hello-d | cat

which sh >/dev/null 2>&1; command -v sudo >/dev/null 2>&1

new_diagnostics() {
  for file in $(ls *.mp3); do echo "$file"; done
  for file in "*.mp3"; do echo "$file"; done
  files=($(printf '%s\n' one two))
  find . -name *.ogg
  find . -exec sh -c 'echo {}' \;
  unset values[0]
  read $target
  for argument in $*; do echo "$argument"; done
  echo "$*"
  printf '%s %s\n' one
  sudo echo protected > output
  exec echo replaced; echo unreachable
  cd missing; echo wrong-directory
  true && false || echo fallback
  echo one | read -r pipeline_value
  echo "$pipeline_value"
  [[ 10 > 7 ]]
  [[ left < right ]]
  [[ value =~ 'v.*' ]]
  [[ -e *.txt ]]
  [[ $left=$right ]]
  [[ -n literal ]]
  echo {1..$limit}
  tr [A-Z] [a-z]
  index=0
  echo redirected > "file$((index++))"
  echo $value
  echo "~"
  echo '$value'
  read -r number
  echo $((number + 1))
  export CDPATH=.:~/project
}
